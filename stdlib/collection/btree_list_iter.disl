; Disl stdlib collection: BTreeListIter<T>
;
; In-order iterator over BTreeList<T>.  Yields elements from index 0 to
; length-1 in insertion-order sequence, delegating to BTreeList.get for
; each position.  Each next() is O(log n).
;
; See btree_set_iter.disl for a note on the O(n log n) vs O(n) tradeoff.
;
; Satisfies concept Iterator<T, BTreeListIter<T>>.

struct BTreeListIter<T>
    list:  Ptr<BTreeList<T>>
    order: I64
    total: I64

routine BTreeListIter<T>.new(#list: Ptr<BTreeList<T>>) -> BTreeListIter<T>
    block entry():
        %total: I64 = #list.length()
        %iter: BTreeListIter<T> = BTreeListIter<T> { list: #list, order: 0, total: %total }
        return(%iter)

routine BTreeListIter<T>.next(#self: Ptr<BTreeListIter<T>>) -> Option<T>
    block entry():
        %order: I64  := #self.order
        %total: I64  := #self.total
        %done:  Bool = sge(%order, %total)
        branch %done ? return_none() : return_some(%order)

    block return_none():
        %none: Option<T> = Option<T>.none()
        return(%none)

    block return_some(%order: I64):
        #list:  Ptr<BTreeList<T>> := #self.list
        %value: T                 = #list.get(%order)
        #self.order = %order + 1
        %some: Option<T> = Option<T>.some(%value)
        return(%some)
