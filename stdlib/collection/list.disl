; Disl stdlib collection: List<T>
;
; Dynamic array. The allocator is stored in the struct; callers do not pass it
; to individual operations.

struct List<T>
conform Equal<List<T>>
require T: typename, Equal<T>
    data: Ptr<T>
    length: I64
    capacity: I64
    alloc: Ptr<Allocator>

routine List<T>.new(#alloc: Ptr<Allocator>) -> List<T>
require T: typename
    block entry():
        %list: List<T> = List<T> {
            data: null,
            length: 0,
            capacity: 0,
            alloc: #alloc
        }
        return(%list)

routine List<T>.length(#self: Ptr<List<T>>) -> I64
require T: typename
    block entry():
        %length: I64 := #self.length
        return(%length)

routine List<T>.is_empty(#self: Ptr<List<T>>) -> Bool
require T: typename
    block entry():
        %length: I64 := #self.length
        %empty: Bool = %length == 0
        return(%empty)

routine List<T>.reserve(#self: Ptr<List<T>>, %capacity: I64) -> Void
require T: typename
    block entry():
        %old_capacity: I64 := #self.capacity
        %enough: Bool = sge(%old_capacity, %capacity)
        branch %enough ? return() : grow(%capacity)

    block grow(%capacity: I64):
        #alloc: Ptr<Allocator> := #self.alloc
        #old_data: Ptr<T> := #self.data
        #new_data: Ptr<T> = realloc<T>(#alloc, #old_data, %capacity)
        %failed: Bool = #new_data == null
        branch %failed ? trap() : install(#new_data, %capacity)

    block install(#new_data: Ptr<T>, %capacity: I64):
        #self.data = #new_data
        #self.capacity = %capacity
        return()

routine List<T>.ensure_capacity(#self: Ptr<List<T>>, %wanted: I64) -> Void
require T: typename
    block entry():
        %capacity: I64 := #self.capacity
        %enough: Bool = sge(%capacity, %wanted)
        branch %enough ? return() : choose(%capacity, %wanted)

    block choose(%capacity: I64, %wanted: I64):
        %empty: Bool = %capacity == 0
        branch %empty ? initial(%wanted) : double(%capacity, %wanted)

    block initial(%wanted: I64):
        %base: I64 = 4
        %use_wanted: Bool = sgt(%wanted, %base)
        %new_capacity: I64 = %use_wanted ? %wanted : %base
        #self.reserve(%new_capacity)
        return()

    block double(%capacity: I64, %wanted: I64):
        %next: I64 = %capacity * 2
        %enough: Bool = sge(%next, %wanted)
        branch %enough ? reserve(%next) : double(%next, %wanted)

    block reserve(%new_capacity: I64):
        #self.reserve(%new_capacity)
        return()

routine List<T>.push(#self: Ptr<List<T>>, %value: T) -> Void
require T: typename
    block entry():
        %length: I64 := #self.length
        %wanted: I64 = %length + 1
        #self.ensure_capacity(%wanted)
        #data: Ptr<T> := #self.data
        #data[%length] = %value
        #self.length = %wanted
        return()

routine List<T>.pop(#self: Ptr<List<T>>) -> T
require T: typename
    block entry():
        %length: I64 := #self.length
        %empty: Bool = %length == 0
        branch %empty ? trap() : pop(%length)

    block pop(%length: I64):
        %index: I64 = %length - 1
        #data: Ptr<T> := #self.data
        %value: T := #data[%index]
        #self.length = %index
        return(%value)

routine List<T>.get(#self: Ptr<List<T>>, %index: I64) -> T
require T: typename
    block entry():
        %length: I64 := #self.length
        %not_negative: Bool = sge(%index, 0)
        %before_end: Bool = slt(%index, %length)
        %in_bounds: Bool = %not_negative & %before_end
        branch %in_bounds ? load(%index) : trap()

    block load(%index: I64):
        #data: Ptr<T> := #self.data
        %value: T := #data[%index]
        return(%value)

routine List<T>.set(#self: Ptr<List<T>>, %index: I64, %value: T) -> Void
require T: typename
    block entry():
        %length: I64 := #self.length
        %not_negative: Bool = sge(%index, 0)
        %before_end: Bool = slt(%index, %length)
        %in_bounds: Bool = %not_negative & %before_end
        branch %in_bounds ? store(%index, %value) : trap()

    block store(%index: I64, %value: T):
        #data: Ptr<T> := #self.data
        #data[%index] = %value
        return()

routine List<T>.clear(#self: Ptr<List<T>>) -> Void
require T: typename
    block entry():
        #self.length = 0
        return()

routine List<T>.equals(%a: List<T>, %b: List<T>) -> Bool
require T: typename, Equal<T>
    block entry():
        %la: I64 = %a.length
        %lb: I64 = %b.length
        %same_len: Bool = %la == %lb
        branch %same_len ? scan(%a, %b, %la) : return(false)

    block scan(%a: List<T>, %b: List<T>, %len: I64):
        #pa: Ptr<T> = %a.data
        #pb: Ptr<T> = %b.data
        jump loop(0, %len, #pa, #pb)

    block loop(%i: I64, %len: I64, #pa: Ptr<T>, #pb: Ptr<T>):
        %done: Bool = sge(%i, %len)
        branch %done ? return(true) : step(%i, %len, #pa, #pb)

    block step(%i: I64, %len: I64, #pa: Ptr<T>, #pb: Ptr<T>):
        %x: T := #pa[%i]
        %y: T := #pb[%i]
        %eq: Bool = %x.equals(%y)
        %i_next: I64 = %i + 1
        branch %eq ? loop(%i_next, %len, #pa, #pb) : return(false)

routine List<T>.free(#self: Ptr<List<T>>) -> Void
require T: typename
    block entry():
        #data: Ptr<T> := #self.data
        %empty: Bool = #data == null
        branch %empty ? reset() : release(#data)

    block release(#data: Ptr<T>):
        #alloc: Ptr<Allocator> := #self.alloc
        free<T>(#alloc, #data)
        jump reset()

    block reset():
        #self.data = null
        #self.length = 0
        #self.capacity = 0
        return()
