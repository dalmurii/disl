; Disl stdlib collection: Deque<T>
;
; Dynamic array with a centered start index — front and back both grow without
; shifting. The allocator is stored in the struct.
;
; Logical element i lives at data[start + i]. Front growth consumes spare slots
; before start; when either side runs out the live range is moved into a larger
; centered buffer.

struct Deque<T>
    require T: typename
    data: Ptr<T>
    start: I64
    length: I64
    capacity: I64
    alloc: Ptr<Allocator>

routine Deque<T>.new(#alloc: Ptr<Allocator>) -> Deque<T>
    require T: typename
    block entry():
        %deque: Deque<T> = Deque<T> {
            data: null,
            start: 0,
            length: 0,
            capacity: 0,
            alloc: #alloc
        }
        return(%deque)

routine Deque<T>.length(#self: Ptr<Deque<T>>) -> I64
    require T: typename
    block entry():
        %length: I64 := #self.length
        return(%length)

routine Deque<T>.is_empty(#self: Ptr<Deque<T>>) -> Bool
    require T: typename
    block entry():
        %length: I64 := #self.length
        %empty: Bool = %length == 0
        return(%empty)

routine Deque<T>.recenter(#self: Ptr<Deque<T>>, %new_capacity: I64) -> Void
    require T: typename
    block entry():
        %length: I64 := #self.length
        %slack: I64 = %new_capacity - %length
        %new_start: I64 = sdiv(%slack, 2)
        #alloc: Ptr<Allocator> := #self.alloc
        #new_data: Ptr<T> = alloc<T>(#alloc, %new_capacity)
        %failed: Bool = #new_data == null
        branch %failed ? trap() : move(#new_data, %new_start, %length, %new_capacity, #alloc)

    block move(#new_data: Ptr<T>, %new_start: I64, %length: I64, %new_capacity: I64, #alloc: Ptr<Allocator>):
        #old_data: Ptr<T> := #self.data
        %old_null: Bool = #old_data == null
        branch %old_null ? install(#new_data, %new_start, %new_capacity) : copy_live(#new_data, %new_start, #old_data, %length, %new_capacity, #alloc)

    block copy_live(#new_data: Ptr<T>, %new_start: I64, #old_data: Ptr<T>, %length: I64, %new_capacity: I64, #alloc: Ptr<Allocator>):
        %old_start: I64 := #self.start
        #src: Ptr<T> = #old_data[%old_start]
        #dst: Ptr<T> = #new_data[%new_start]
        copy<T>(#dst, #src, %length)
        free<T>(#alloc, #old_data)
        jump install(#new_data, %new_start, %new_capacity)

    block install(#new_data: Ptr<T>, %new_start: I64, %new_capacity: I64):
        #self.data = #new_data
        #self.start = %new_start
        #self.capacity = %new_capacity
        return()

routine Deque<T>.ensure_front(#self: Ptr<Deque<T>>) -> Void
    require T: typename
    block entry():
        %start: I64 := #self.start
        %has_front_space: Bool = sgt(%start, 0)
        branch %has_front_space ? return() : choose()

    block choose():
        %capacity: I64 := #self.capacity
        %empty: Bool = %capacity == 0
        branch %empty ? initial() : grow(%capacity)

    block initial():
        #self.recenter(4)
        return()

    block grow(%capacity: I64):
        %new_capacity: I64 = %capacity * 2
        #self.recenter(%new_capacity)
        return()

routine Deque<T>.ensure_back(#self: Ptr<Deque<T>>) -> Void
    require T: typename
    block entry():
        %start: I64 := #self.start
        %length: I64 := #self.length
        %capacity: I64 := #self.capacity
        %end: I64 = %start + %length
        %has_back_space: Bool = slt(%end, %capacity)
        branch %has_back_space ? return() : choose(%capacity)

    block choose(%capacity: I64):
        %empty: Bool = %capacity == 0
        branch %empty ? initial() : grow(%capacity)

    block initial():
        #self.recenter(4)
        return()

    block grow(%capacity: I64):
        %new_capacity: I64 = %capacity * 2
        #self.recenter(%new_capacity)
        return()

routine Deque<T>.push_back(#self: Ptr<Deque<T>>, %value: T) -> Void
    require T: typename
    block entry():
        #self.ensure_back()
        #data: Ptr<T> := #self.data
        %start: I64 := #self.start
        %length: I64 := #self.length
        %index: I64 = %start + %length
        #data[%index] = %value
        #self.length = %length + 1
        return()

routine Deque<T>.push(#self: Ptr<Deque<T>>, %value: T) -> Void
    require T: typename
    block entry:
        #self.push_back(%value)
        return()

routine Deque<T>.push_front(#self: Ptr<Deque<T>>, %value: T) -> Void
    require T: typename
    block entry:
        #self.ensure_front()
        #data: Ptr<T> := #self.data
        %start: I64 := #self.start
        %new_start: I64 = %start - 1
        #data[%new_start] = %value
        #self.start = %new_start
        %length: I64 := #self.length
        #self.length = %length + 1
        return()

routine Deque<T>.pop_back(#self: Ptr<Deque<T>>) -> T
    require T: typename
    block entry:
        %length: I64 := #self.length
        %empty: Bool = %length == 0
        branch %empty ? trap() : pop(%length)

    block pop(%length: I64):
        %new_length: I64 = %length - 1
        #data: Ptr<T> := #self.data
        %start: I64 := #self.start
        %index: I64 = %start + %new_length
        %value: T := #data[%index]
        #self.length = %new_length
        return(%value)

routine Deque<T>.pop(#self: Ptr<Deque<T>>) -> T
    require T: typename
    block entry:
        %value: T = #self.pop_back()
        return(%value)

routine Deque<T>.pop_front(#self: Ptr<Deque<T>>) -> T
    require T: typename
    block entry:
        %length: I64 := #self.length
        %empty: Bool = %length == 0
        branch %empty ? trap() : pop(%length)

    block pop(%length: I64):
        #data: Ptr<T> := #self.data
        %start: I64 := #self.start
        %value: T := #data[%start]
        #self.start = %start + 1
        #self.length = %length - 1
        return(%value)

routine Deque<T>.get(#self: Ptr<Deque<T>>, %index: I64) -> T
    require T: typename
    block entry:
        %length: I64 := #self.length
        %not_negative: Bool = sge(%index, 0)
        %before_end: Bool = slt(%index, %length)
        %in_bounds: Bool = %not_negative & %before_end
        branch %in_bounds ? load(%index) : trap()

    block load(%index: I64):
        #data: Ptr<T> := #self.data
        %start: I64 := #self.start
        %physical: I64 = %start + %index
        %value: T := #data[%physical]
        return(%value)

routine Deque<T>.set(#self: Ptr<Deque<T>>, %index: I64, %value: T) -> Void
    require T: typename
    block entry:
        %length: I64 := #self.length
        %not_negative: Bool = sge(%index, 0)
        %before_end: Bool = slt(%index, %length)
        %in_bounds: Bool = %not_negative & %before_end
        branch %in_bounds ? store(%index, %value) : trap()

    block store(%index: I64, %value: T):
        #data: Ptr<T> := #self.data
        %start: I64 := #self.start
        %physical: I64 = %start + %index
        #data[%physical] = %value
        return()

routine Deque<T>.clear(#self: Ptr<Deque<T>>) -> Void
    require T: typename
    block entry:
        %capacity: I64 := #self.capacity
        %start: I64 = sdiv(%capacity, 2)
        #self.start = %start
        #self.length = 0
        return()

routine Deque<T>.free(#self: Ptr<Deque<T>>) -> Void
    require T: typename
    block entry:
        #data: Ptr<T> := #self.data
        %empty: Bool = #data == null
        branch %empty ? reset() : release(#data)

    block release(#data: Ptr<T>):
        #alloc: Ptr<Allocator> := #self.alloc
        free<T>(#alloc, #data)
        jump reset()

    block reset():
        #self.data = null
        #self.start = 0
        #self.length = 0
        #self.capacity = 0
        return()
