; Disl stdlib collection: BTreeMap<K, V>
;
; Order-statistic B-tree map with a fixed node key capacity of NODE_KEYS.
; Nodes store keys/values/children inline with fixed arrays.
; The allocator is stored in BTreeMap; node helpers still receive it as a parameter.

const NODE_KEYS: I64 = 7
const NODE_CHILDREN: I64 = NODE_KEYS + 1
const NODE_MIN_KEYS: I64 = sdiv(NODE_KEYS + 1, 2)

struct BTreeMapNode<K, V>
    leaf: Bool
    length: I64
    subtree_count: I64
    keys: Array<K, NODE_KEYS>
    values: Array<V, NODE_KEYS>
    children: Array<Ptr<BTreeMapNode<K, V>>, NODE_CHILDREN>

struct BTreeMap<K, V>
    root: Ptr<BTreeMapNode<K, V>>
    length: I64
    compare_fn: Callable<@callconv("c"), (K, K), I32>
    alloc: Ptr<Allocator>

routine BTreeMap<K, V>::new(
    %compare_fn: Callable<@callconv("c"), (K, K), I32>,
    #alloc: Ptr<Allocator>
) -> BTreeMap<K, V>
    block entry():
        %map: BTreeMap<K, V> = BTreeMap<K, V> {
            root: null,
            length: 0,
            compare_fn: %compare_fn,
            alloc: #alloc
        }
        return %map

routine BTreeMap<K, V>::length(#self: Ptr<BTreeMap<K, V>>) -> I64
    block entry():
        %length: I64 := #self.length
        return %length

routine BTreeMapNode<K, V>::new(%leaf: Bool, #alloc: Ptr<Allocator>) -> Ptr<BTreeMapNode<K, V>>
    block entry():
        #node: Ptr<BTreeMapNode<K, V>> = alloc<BTreeMapNode<K, V>>(#alloc, 1)
        %failed: Bool = #node == null
        branch %failed ? trap() : init(#node, %leaf)

    block init(#node: Ptr<BTreeMapNode<K, V>>, %leaf: Bool):
        #node.leaf = %leaf
        #node.length = 0
        #node.subtree_count = 0
        return #node

routine BTreeMapNode<K, V>::count(#self: Ptr<BTreeMapNode<K, V>>) -> I64
    block entry():
        %empty: Bool = #self == null
        branch %empty ? return 0 : count(#self)

    block count(#self: Ptr<BTreeMapNode<K, V>>):
        %count: I64 := #self.subtree_count
        return %count

routine BTreeMapNode<K, V>::recount(#self: Ptr<BTreeMapNode<K, V>>) -> Void
    block entry():
        %leaf: Bool := #self.leaf
        %length: I64 := #self.length
        branch %leaf ? leaf_count(%length) : internal_count(%length)

    block leaf_count(%length: I64):
        #self.subtree_count = %length
        return

    block internal_count(%length: I64):
        jump loop(0, 0, %length)

    block loop(%i: I64, %sum: I64, %length: I64):
        %done: Bool = sgt(%i, %length)
        branch %done ? finish(%sum) : add_child(%i, %sum, %length)

    block add_child(%i: I64, %sum: I64, %length: I64):
        #child: Ptr<BTreeMapNode<K, V>> := #self.children[%i]
        %child_count: I64 = #child.count()
        %with_child: I64 = %sum + %child_count
        %has_key: Bool = slt(%i, %length)
        %next_sum: I64 = %has_key ? %with_child + 1 : %with_child
        jump loop(%i + 1, %next_sum, %length)

    block finish(%sum: I64):
        #self.subtree_count = %sum
        return

routine BTreeMap<K, V>::find_index(#self: Ptr<BTreeMap<K, V>>, #node: Ptr<BTreeMapNode<K, V>>, %key: K) -> I64
    block entry():
        jump loop(0)

    block loop(%i: I64):
        %length: I64 := #node.length
        %done: Bool = sge(%i, %length)
        branch %done ? return %i : compare(%i)

    block compare(%i: I64):
        %node_key: K := #node.keys[%i]
        %cmp: I32 = #self.compare_fn(%key, %node_key)
        %before_or_equal: Bool = sle(%cmp, 0)
        branch %before_or_equal ? return %i : loop(%i + 1)

routine BTreeMap<K, V>::get(#self: Ptr<BTreeMap<K, V>>, %key: K) -> V
    block entry():
        #root: Ptr<BTreeMapNode<K, V>> := #self.root
        %empty: Bool = #root == null
        branch %empty ? trap() : search(#root, %key)

    block search(#node: Ptr<BTreeMapNode<K, V>>, %key: K):
        %i: I64 = #self.find_index(#node, %key)
        %length: I64 := #node.length
        %inside: bool = slt(%i, %length)
        branch %inside ? maybe_match(#node, %i, %key) : descend_or_missing(#node, %i, %key)

    block maybe_match(#node: Ptr<BTreeMapNode<K, V>>, %i: I64, %key: K):
        %node_key: K := #node.keys[%i]
        %cmp: I32 = #self.compare_fn(%key, %node_key)
        %equal: bool = %cmp == 0
        branch %equal ? load(#node, %i) : descend_or_missing(#node, %i, %key)

    block descend_or_missing(#node: Ptr<BTreeMapNode<K, V>>, %i: I64, %key: K):
        %leaf: bool := #node.leaf
        branch %leaf ? trap() : descend(#node, %i, %key)

    block descend(#node: Ptr<BTreeMapNode<K, V>>, %i: I64, %key: K):
        #child: Ptr<BTreeMapNode<K, V>> := #node.children[%i]
        jump search(#child, %key)

    block load(#node: Ptr<BTreeMapNode<K, V>>, %i: I64):
        %value: V := #node.values[%i]
        return %value

routine BTreeMap<K, V>::contains(#self: Ptr<BTreeMap<K, V>>, %key: K) -> bool
    block entry():
        #root: Ptr<BTreeMapNode<K, V>> := #self.root
        %empty: bool = #root == null
        branch %empty ? return false : search(#root, %key)

    block search(#node: Ptr<BTreeMapNode<K, V>>, %key: K):
        %i: i64 = #self.find_index(#node, %key)
        %length: i64 := #node.length
        %inside: bool = slt(%i, %length)
        branch %inside ? maybe_match(#node, %i, %key) : descend_or_missing(#node, %i, %key)

    block maybe_match(#node: Ptr<BTreeMapNode<K, V>>, %i: i64, %key: K):
        %node_key: K := #node.keys[%i]
        %cmp: I32 = #self.compare_fn(%key, %node_key)
        %equal: bool = %cmp == 0
        branch %equal ? return true : descend_or_missing(#node, %i, %key)

    block descend_or_missing(#node: Ptr<BTreeMapNode<K, V>>, %i: i64, %key: K):
        %leaf: bool := #node.leaf
        branch %leaf ? return false : descend(#node, %i, %key)

    block descend(#node: Ptr<BTreeMapNode<K, V>>, %i: i64, %key: K):
        #child: Ptr<BTreeMapNode<K, V>> := #node.children[%i]
        jump search(#child, %key)

routine BTreeMap<K, V>::get_order(#self: Ptr<BTreeMap<K, V>>, %order: i64) -> V
    block entry():
        %not_negative: bool = sge(%order, 0)
        %length: i64 := #self.length
        %before_end: bool = slt(%order, %length)
        %in_bounds: bool = %not_negative & %before_end
        branch %in_bounds ? select_root(%order) : trap()

    block select_root(%order: i64):
        #root: Ptr<BTreeMapNode<K, V>> := #self.root
        jump select_node(#root, %order)

    block select_node(#node: Ptr<BTreeMapNode<K, V>>, %order: i64):
        jump scan(#node, %order, 0)

    block scan(#node: Ptr<BTreeMapNode<K, V>>, %order: i64, %i: i64):
        %length: i64 := #node.length
        %done: bool = sge(%i, %length)
        branch %done ? last_child(#node, %order, %i) : check_child(#node, %order, %i)

    block check_child(#node: Ptr<BTreeMapNode<K, V>>, %order: i64, %i: i64):
        %leaf: bool := #node.leaf
        branch %leaf ? leaf_key(#node, %order, %i) : internal_child(#node, %order, %i)

    block leaf_key(#node: Ptr<BTreeMapNode<K, V>>, %order: i64, %i: i64):
        %match: bool = %order == %i
        branch %match ? load_order(#node, %i) : scan(#node, %order, %i + 1)

    block internal_child(#node: Ptr<BTreeMapNode<K, V>>, %order: i64, %i: i64):
        #child: Ptr<BTreeMapNode<K, V>> := #node.children[%i]
        %child_count: i64 = #child.count()
        %in_child: bool = slt(%order, %child_count)
        branch %in_child ? select_node(#child, %order) : check_key(#node, %order, %i, %child_count)

    block check_key(#node: Ptr<BTreeMapNode<K, V>>, %order: i64, %i: i64, %child_count: i64):
        %after_child: i64 = %order - %child_count
        %is_key: bool = %after_child == 0
        branch %is_key ? load_order(#node, %i) : scan(#node, %after_child - 1, %i + 1)

    block last_child(#node: Ptr<BTreeMapNode<K, V>>, %order: i64, %i: i64):
        %leaf: bool := #node.leaf
        branch %leaf ? trap() : descend_last(#node, %order, %i)

    block descend_last(#node: Ptr<BTreeMapNode<K, V>>, %order: i64, %i: i64):
        #child: Ptr<BTreeMapNode<K, V>> := #node.children[%i]
        jump select_node(#child, %order)

    block load_order(#node: Ptr<BTreeMapNode<K, V>>, %i: i64):
        %value: V := #node.values[%i]
        return %value

routine BTreeMap<K, V>::key_order(#self: Ptr<BTreeMap<K, V>>, %order: i64) -> K
    block entry():
        %not_negative: bool = sge(%order, 0)
        %length: i64 := #self.length
        %before_end: bool = slt(%order, %length)
        %in_bounds: bool = %not_negative & %before_end
        branch %in_bounds ? select_root(%order) : trap()

    block select_root(%order: i64):
        #root: Ptr<BTreeMapNode<K, V>> := #self.root
        jump select_node(#root, %order)

    block select_node(#node: Ptr<BTreeMapNode<K, V>>, %order: i64):
        jump scan(#node, %order, 0)

    block scan(#node: Ptr<BTreeMapNode<K, V>>, %order: i64, %i: i64):
        %length: i64 := #node.length
        %done: bool = sge(%i, %length)
        branch %done ? last_child(#node, %order, %i) : check_child(#node, %order, %i)

    block check_child(#node: Ptr<BTreeMapNode<K, V>>, %order: i64, %i: i64):
        %leaf: bool := #node.leaf
        branch %leaf ? leaf_key(#node, %order, %i) : internal_child(#node, %order, %i)

    block leaf_key(#node: Ptr<BTreeMapNode<K, V>>, %order: i64, %i: i64):
        %match: bool = %order == %i
        branch %match ? load_key(#node, %i) : scan(#node, %order, %i + 1)

    block internal_child(#node: Ptr<BTreeMapNode<K, V>>, %order: i64, %i: i64):
        #child: Ptr<BTreeMapNode<K, V>> := #node.children[%i]
        %child_count: i64 = #child.count()
        %in_child: bool = slt(%order, %child_count)
        branch %in_child ? select_node(#child, %order) : check_key(#node, %order, %i, %child_count)

    block check_key(#node: Ptr<BTreeMapNode<K, V>>, %order: i64, %i: i64, %child_count: i64):
        %after_child: i64 = %order - %child_count
        %is_key: bool = %after_child == 0
        branch %is_key ? load_key(#node, %i) : scan(#node, %after_child - 1, %i + 1)

    block last_child(#node: Ptr<BTreeMapNode<K, V>>, %order: i64, %i: i64):
        %leaf: bool := #node.leaf
        branch %leaf ? trap() : descend_last(#node, %order, %i)

    block descend_last(#node: Ptr<BTreeMapNode<K, V>>, %order: i64, %i: i64):
        #child: Ptr<BTreeMapNode<K, V>> := #node.children[%i]
        jump select_node(#child, %order)

    block load_key(#node: Ptr<BTreeMapNode<K, V>>, %i: i64):
        %key: K := #node.keys[%i]
        return %key

routine BTreeMapNode<K, V>::split_child(#self: Ptr<BTreeMapNode<K, V>>, %index: i64, #alloc: Ptr<Allocator>) -> Void
    block entry():
        #left: Ptr<BTreeMapNode<K, V>> := #self.children[%index]
        %leaf: bool := #left.leaf
        #right: Ptr<BTreeMapNode<K, V>> = BTreeMapNode<K, V>::new(%leaf, #alloc)
        %mid: i64 = sdiv(NODE_KEYS, 2)
        %right_count: i64 = NODE_KEYS - %mid - 1
        #right.keys.copy(0, #left.keys, %mid + 1, %right_count)
        #right.values.copy(0, #left.values, %mid + 1, %right_count)
        #right.length = %right_count
        branch %leaf ? promote(#left, #right, %mid) : copy_children(#left, #right, %mid, %right_count)

    block copy_children(#left: Ptr<BTreeMapNode<K, V>>, #right: Ptr<BTreeMapNode<K, V>>, %mid: i64, %right_count: i64):
        jump child_loop(0, #left, #right, %mid, %right_count)

    block child_loop(%i: i64, #left: Ptr<BTreeMapNode<K, V>>, #right: Ptr<BTreeMapNode<K, V>>, %mid: i64, %right_count: i64):
        %done: bool = sgt(%i, %right_count)
        branch %done ? promote(#left, #right, %mid) : child_copy(%i, #left, #right, %mid, %right_count)

    block child_copy(%i: i64, #left: Ptr<BTreeMapNode<K, V>>, #right: Ptr<BTreeMapNode<K, V>>, %mid: i64, %right_count: i64):
        %src: i64 = %mid + 1 + %i
        #child: Ptr<BTreeMapNode<K, V>> := #left.children[%src]
        #right.children[%i] = #child
        jump child_loop(%i + 1, #left, #right, %mid, %right_count)

    block promote(#left: Ptr<BTreeMapNode<K, V>>, #right: Ptr<BTreeMapNode<K, V>>, %mid: i64):
        %parent_length: i64 := #self.length
        #self.keys.shift_right(%index, %parent_length)
        #self.values.shift_right(%index, %parent_length)
        jump shift_children(%parent_length, #left, #right, %mid)

    block shift_children(%i: i64, #left: Ptr<BTreeMapNode<K, V>>, #right: Ptr<BTreeMapNode<K, V>>, %mid: i64):
        %stop: i64 = %index + 1
        %done: bool = slt(%i, %stop)
        branch %done ? install(#left, #right, %mid) : move_child(%i, #left, #right, %mid)

    block move_child(%i: i64, #left: Ptr<BTreeMapNode<K, V>>, #right: Ptr<BTreeMapNode<K, V>>, %mid: i64):
        #child: Ptr<BTreeMapNode<K, V>> := #self.children[%i]
        #self.children[%i + 1] = #child
        jump shift_children(%i - 1, #left, #right, %mid)

    block install(#left: Ptr<BTreeMapNode<K, V>>, #right: Ptr<BTreeMapNode<K, V>>, %mid: i64):
        %middle_key: K := #left.keys[%mid]
        %middle_value: V := #left.values[%mid]
        #self.keys[%index] = %middle_key
        #self.values[%index] = %middle_value
        #self.children[%index + 1] = #right
        #left.length = %mid
        %parent_length: i64 := #self.length
        #self.length = %parent_length + 1
        #left.recount()
        #right.recount()
        #self.recount()
        return

routine BTreeMapNode<K, V>::insert_nonfull(#self: Ptr<BTreeMapNode<K, V>>, #map: Ptr<BTreeMap<K, V>>, %key: K, %value: V, #alloc: Ptr<Allocator>) -> Void
    block entry():
        %leaf: bool := #self.leaf
        branch %leaf ? insert_leaf() : insert_internal()

    block insert_leaf():
        %slot: i64 = #map.find_index(#self, %key)
        %length: i64 := #self.length
        #self.keys.shift_right(%slot, %length)
        #self.values.shift_right(%slot, %length)
        #self.keys[%slot] = %key
        #self.values[%slot] = %value
        #self.length = %length + 1
        #self.subtree_count = %length + 1
        return

    block insert_internal():
        %slot: i64 = #map.find_index(#self, %key)
        #child: Ptr<BTreeMapNode<K, V>> := #self.children[%slot]
        %child_length: i64 := #child.length
        %full: bool = %child_length == NODE_KEYS
        branch %full ? split_then_insert(%slot, #child) : descend(%slot, #child)

    block split_then_insert(%slot: i64, #child: Ptr<BTreeMapNode<K, V>>):
        #self.split_child(%slot, #alloc)
        %pivot: K := #self.keys[%slot]
        %cmp: I32 = #map.compare_fn(%key, %pivot)
        %go_right: bool = sgt(%cmp, 0)
        %next_slot: i64 = %go_right ? %slot + 1 : %slot
        #next_child: Ptr<BTreeMapNode<K, V>> := #self.children[%next_slot]
        jump descend(%next_slot, #next_child)

    block descend(%slot: i64, #child: Ptr<BTreeMapNode<K, V>>):
        #child.insert_nonfull(#map, %key, %value, #alloc)
        #self.recount()
        return

routine BTreeMap<K, V>::put(#self: Ptr<BTreeMap<K, V>>, %key: K, %value: V) -> Void
    block entry():
        #root: Ptr<BTreeMapNode<K, V>> := #self.root
        %empty: bool = #root == null
        branch %empty ? first_root() : maybe_replace(#root)

    block first_root():
        #alloc: Ptr<Allocator> := #self.alloc
        #root: Ptr<BTreeMapNode<K, V>> = BTreeMapNode<K, V>::new(true, #alloc)
        #root.keys[0] = %key
        #root.values[0] = %value
        #root.length = 1
        #root.subtree_count = 1
        #self.root = #root
        #self.length = 1
        return

    block maybe_replace(#root: Ptr<BTreeMapNode<K, V>>):
        %replaced: bool = #root.replace(#self, %key, %value)
        branch %replaced ? return : insert_root(#root)

    block insert_root(#root: Ptr<BTreeMapNode<K, V>>):
        #alloc: Ptr<Allocator> := #self.alloc
        %root_length: i64 := #root.length
        %full: bool = %root_length == NODE_KEYS
        branch %full ? split_root(#root, #alloc) : insert_nonfull(#root, #alloc)

    block split_root(#old_root: Ptr<BTreeMapNode<K, V>>, #alloc: Ptr<Allocator>):
        #new_root: Ptr<BTreeMapNode<K, V>> = BTreeMapNode<K, V>::new(false, #alloc)
        #new_root.children[0] = #old_root
        #self.root = #new_root
        #new_root.split_child(0, #alloc)
        jump insert_nonfull(#new_root, #alloc)

    block insert_nonfull(#root: Ptr<BTreeMapNode<K, V>>, #alloc: Ptr<Allocator>):
        #root.insert_nonfull(#self, %key, %value, #alloc)
        %length: i64 := #self.length
        #self.length = %length + 1
        return

routine BTreeMapNode<K, V>::replace(#self: Ptr<BTreeMapNode<K, V>>, #map: Ptr<BTreeMap<K, V>>, %key: K, %value: V) -> bool
    block entry():
        %slot: i64 = #map.find_index(#self, %key)
        %length: i64 := #self.length
        %inside: bool = slt(%slot, %length)
        branch %inside ? maybe_match(%slot) : descend_or_missing(%slot)

    block maybe_match(%slot: i64):
        %node_key: K := #self.keys[%slot]
        %cmp: I32 = #map.compare_fn(%key, %node_key)
        %equal: bool = %cmp == 0
        branch %equal ? replace(%slot) : descend_or_missing(%slot)

    block replace(%slot: i64):
        #self.values[%slot] = %value
        return true

    block descend_or_missing(%slot: i64):
        %leaf: bool := #self.leaf
        branch %leaf ? return false : descend(%slot)

    block descend(%slot: i64):
        #child: Ptr<BTreeMapNode<K, V>> := #self.children[%slot]
        %replaced: bool = #child.replace(#map, %key, %value)
        return %replaced

routine BTreeMapNode<K, V>::remove_leaf_at(#self: Ptr<BTreeMapNode<K, V>>, %index: i64) -> V
    block entry:
        %old: V := #self.values[%index]
        %length: i64 := #self.length
        #self.keys.shift_left(%index, %length)
        #self.values.shift_left(%index, %length)
        #self.length = %length - 1
        #self.subtree_count = %length - 1
        return %old

; Capacity = NODE_KEYS, t = NODE_MIN_KEYS. Non-root nodes maintain
; length >= NODE_MIN_KEYS - 1.
; Helpers below ensure a child has length >= 4 (= t) before any deletion
; descent so the child can absorb a one-key drop without underflowing.

routine BTreeMapNode<K, V>::borrow_from_left(#self: Ptr<BTreeMapNode<K, V>>, %i: i64) -> Void
    block entry:
        #left: Ptr<BTreeMapNode<K, V>> := #self.children[%i - 1]
        #child: Ptr<BTreeMapNode<K, V>> := #self.children[%i]
        %left_length: i64 := #left.length
        %child_length: i64 := #child.length
        #child.keys.shift_right(0, %child_length)
        #child.values.shift_right(0, %child_length)
        %pivot_key: K := #self.keys[%i - 1]
        %pivot_value: V := #self.values[%i - 1]
        #child.keys[0] = %pivot_key
        #child.values[0] = %pivot_value
        %new_pivot_key: K := #left.keys[%left_length - 1]
        %new_pivot_value: V := #left.values[%left_length - 1]
        #self.keys[%i - 1] = %new_pivot_key
        #self.values[%i - 1] = %new_pivot_value
        %leaf: bool := #child.leaf
        branch %leaf ? finalize(#left, #child, %left_length, %child_length) : move_child(#left, #child, %left_length, %child_length)

    block move_child(#left: Ptr<BTreeMapNode<K, V>>, #child: Ptr<BTreeMapNode<K, V>>, %left_length: i64, %child_length: i64):
        %child_count: i64 = %child_length + 1
        #child.children.shift_right(0, %child_count)
        #moved: Ptr<BTreeMapNode<K, V>> := #left.children[%left_length]
        #child.children[0] = #moved
        jump finalize(#left, #child, %left_length, %child_length)

    block finalize(#left: Ptr<BTreeMapNode<K, V>>, #child: Ptr<BTreeMapNode<K, V>>, %left_length: i64, %child_length: i64):
        #left.length = %left_length - 1
        #child.length = %child_length + 1
        #left.recount()
        #child.recount()
        #self.recount()
        return

routine BTreeMapNode<K, V>::borrow_from_right(#self: Ptr<BTreeMapNode<K, V>>, %i: i64) -> Void
    block entry:
        #child: Ptr<BTreeMapNode<K, V>> := #self.children[%i]
        #right: Ptr<BTreeMapNode<K, V>> := #self.children[%i + 1]
        %child_length: i64 := #child.length
        %right_length: i64 := #right.length
        %pivot_key: K := #self.keys[%i]
        %pivot_value: V := #self.values[%i]
        #child.keys[%child_length] = %pivot_key
        #child.values[%child_length] = %pivot_value
        %new_pivot_key: K := #right.keys[0]
        %new_pivot_value: V := #right.values[0]
        #self.keys[%i] = %new_pivot_key
        #self.values[%i] = %new_pivot_value
        #right.keys.shift_left(0, %right_length)
        #right.values.shift_left(0, %right_length)
        %leaf: bool := #child.leaf
        branch %leaf ? finalize(#child, #right, %child_length, %right_length) : move_child(#child, #right, %child_length, %right_length)

    block move_child(#child: Ptr<BTreeMapNode<K, V>>, #right: Ptr<BTreeMapNode<K, V>>, %child_length: i64, %right_length: i64):
        #moved: Ptr<BTreeMapNode<K, V>> := #right.children[0]
        #child.children[%child_length + 1] = #moved
        %right_child_count: i64 = %right_length + 1
        #right.children.shift_left(0, %right_child_count)
        jump finalize(#child, #right, %child_length, %right_length)

    block finalize(#child: Ptr<BTreeMapNode<K, V>>, #right: Ptr<BTreeMapNode<K, V>>, %child_length: i64, %right_length: i64):
        #child.length = %child_length + 1
        #right.length = %right_length - 1
        #child.recount()
        #right.recount()
        #self.recount()
        return

routine BTreeMapNode<K, V>::merge_children(#self: Ptr<BTreeMapNode<K, V>>, %i: i64, #alloc: Ptr<Allocator>) -> Void
    block entry:
        #left: Ptr<BTreeMapNode<K, V>> := #self.children[%i]
        #right: Ptr<BTreeMapNode<K, V>> := #self.children[%i + 1]
        %left_length: i64 := #left.length
        %right_length: i64 := #right.length
        %pivot_key: K := #self.keys[%i]
        %pivot_value: V := #self.values[%i]
        #left.keys[%left_length] = %pivot_key
        #left.values[%left_length] = %pivot_value
        %dst_start: i64 = %left_length + 1
        #left.keys.copy(%dst_start, #right.keys, 0, %right_length)
        #left.values.copy(%dst_start, #right.values, 0, %right_length)
        %leaf: bool := #left.leaf
        branch %leaf ? finalize(#left, #right, %left_length, %right_length) : copy_children(#left, #right, %left_length, %right_length)

    block copy_children(#left: Ptr<BTreeMapNode<K, V>>, #right: Ptr<BTreeMapNode<K, V>>, %left_length: i64, %right_length: i64):
        %right_child_count: i64 = %right_length + 1
        %dst_start: i64 = %left_length + 1
        #left.children.copy(%dst_start, #right.children, 0, %right_child_count)
        jump finalize(#left, #right, %left_length, %right_length)

    block finalize(#left: Ptr<BTreeMapNode<K, V>>, #right: Ptr<BTreeMapNode<K, V>>, %left_length: i64, %right_length: i64):
        %merged_length: i64 = %left_length + 1 + %right_length
        #left.length = %merged_length
        %parent_length: i64 := #self.length
        #self.keys.shift_left(%i, %parent_length)
        #self.values.shift_left(%i, %parent_length)
        %parent_child_count: i64 = %parent_length + 1
        #self.children.shift_left(%i + 1, %parent_child_count)
        #self.length = %parent_length - 1
        free<BTreeMapNode<K, V>>(#alloc, #right)
        #left.recount()
        #self.recount()
        return

routine BTreeMapNode<K, V>::ensure_min(#self: Ptr<BTreeMapNode<K, V>>, %i: i64, #alloc: Ptr<Allocator>) -> i64
    block entry:
        #child: Ptr<BTreeMapNode<K, V>> := #self.children[%i]
        %child_length: i64 := #child.length
        %ok: bool = sge(%child_length, NODE_MIN_KEYS)
        branch %ok ? return %i : try_left()

    block try_left():
        %has_left: bool = sgt(%i, 0)
        branch %has_left ? check_left() : try_right(false)

    block check_left():
        #left: Ptr<BTreeMapNode<K, V>> := #self.children[%i - 1]
        %left_length: i64 := #left.length
        %left_ok: bool = sge(%left_length, NODE_MIN_KEYS)
        branch %left_ok ? do_borrow_left() : try_right(true)

    block do_borrow_left():
        #self.borrow_from_left(%i)
        return %i

    block try_right(%has_left: bool):
        %parent_length: i64 := #self.length
        %has_right: bool = slt(%i, %parent_length)
        branch %has_right ? check_right(%has_left) : pick_merge_no_right(%has_left)

    block check_right(%has_left: bool):
        #right: Ptr<BTreeMapNode<K, V>> := #self.children[%i + 1]
        %right_length: i64 := #right.length
        %right_ok: bool = sge(%right_length, NODE_MIN_KEYS)
        branch %right_ok ? do_borrow_right() : pick_merge(%has_left)

    block do_borrow_right():
        #self.borrow_from_right(%i)
        return %i

    block pick_merge(%has_left: bool):
        branch %has_left ? merge_with_left() : merge_with_right()

    block pick_merge_no_right(%has_left: bool):
        branch %has_left ? merge_with_left() : trap()

    block merge_with_left():
        #self.merge_children(%i - 1, #alloc)
        return %i - 1

    block merge_with_right():
        #self.merge_children(%i, #alloc)
        return %i

routine BTreeMapNode<K, V>::take_max_key(#self: Ptr<BTreeMapNode<K, V>>, #map: Ptr<BTreeMap<K, V>>, #out_value: Ptr<V>) -> K
    block entry:
        %leaf: bool := #self.leaf
        branch %leaf ? leaf_take() : descend()

    block leaf_take():
        %length: i64 := #self.length
        %index: i64 = %length - 1
        %key: K := #self.keys[%index]
        %value: V = #self.remove_leaf_at(%index)
        #out_value = %value
        return %key

    block descend():
        %length: i64 := #self.length
        #alloc: Ptr<Allocator> := #map.alloc
        %actual: i64 = #self.ensure_min(%length, #alloc)
        #child: Ptr<BTreeMapNode<K, V>> := #self.children[%actual]
        %key: K = #child.take_max_key(#map, #out_value)
        #self.recount()
        return %key

routine BTreeMapNode<K, V>::take_min_key(#self: Ptr<BTreeMapNode<K, V>>, #map: Ptr<BTreeMap<K, V>>, #out_value: Ptr<V>) -> K
    block entry:
        %leaf: bool := #self.leaf
        branch %leaf ? leaf_take() : descend()

    block leaf_take():
        %key: K := #self.keys[0]
        %value: V = #self.remove_leaf_at(0)
        #out_value = %value
        return %key

    block descend():
        #alloc: Ptr<Allocator> := #map.alloc
        %actual: i64 = #self.ensure_min(0, #alloc)
        #child: Ptr<BTreeMapNode<K, V>> := #self.children[%actual]
        %key: K = #child.take_min_key(#map, #out_value)
        #self.recount()
        return %key

routine BTreeMapNode<K, V>::remove(#self: Ptr<BTreeMapNode<K, V>>, #map: Ptr<BTreeMap<K, V>>, %key: K) -> bool
    block entry:
        %slot: i64 = #map.find_index(#self, %key)
        %length: i64 := #self.length
        %inside: bool = slt(%slot, %length)
        branch %inside ? maybe_match(%slot) : descend_or_missing(%slot)

    block maybe_match(%slot: i64):
        %node_key: K := #self.keys[%slot]
        %cmp: I32 = #map.compare_fn(%key, %node_key)
        %equal: bool = %cmp == 0
        branch %equal ? remove_here(%slot) : descend_or_missing(%slot)

    block remove_here(%slot: i64):
        %leaf: bool := #self.leaf
        branch %leaf ? remove_leaf(%slot) : remove_internal(%slot)

    block remove_leaf(%slot: i64):
        #self.remove_leaf_at(%slot)
        return true

    block remove_internal(%slot: i64):
        #left: Ptr<BTreeMapNode<K, V>> := #self.children[%slot]
        %left_length: i64 := #left.length
        %left_ok: bool = sge(%left_length, NODE_MIN_KEYS)
        branch %left_ok ? take_pred(%slot) : try_succ(%slot)

    block take_pred(%slot: i64):
        #out: Ptr<V> = alloca<V>
        #left: Ptr<BTreeMapNode<K, V>> := #self.children[%slot]
        %replacement_key: K = #left.take_max_key(#map, #out)
        %replacement_value: V := #out
        #self.keys[%slot] = %replacement_key
        #self.values[%slot] = %replacement_value
        #self.recount()
        return true

    block try_succ(%slot: i64):
        #right: Ptr<BTreeMapNode<K, V>> := #self.children[%slot + 1]
        %right_length: i64 := #right.length
        %right_ok: bool = sge(%right_length, NODE_MIN_KEYS)
        branch %right_ok ? take_succ(%slot) : merge_and_recurse(%slot)

    block take_succ(%slot: i64):
        #out: Ptr<V> = alloca<V>
        #right: Ptr<BTreeMapNode<K, V>> := #self.children[%slot + 1]
        %replacement_key: K = #right.take_min_key(#map, #out)
        %replacement_value: V := #out
        #self.keys[%slot] = %replacement_key
        #self.values[%slot] = %replacement_value
        #self.recount()
        return true

    block merge_and_recurse(%slot: i64):
        #alloc: Ptr<Allocator> := #map.alloc
        #self.merge_children(%slot, #alloc)
        #merged: Ptr<BTreeMapNode<K, V>> := #self.children[%slot]
        %removed: bool = #merged.remove(#map, %key)
        #self.recount()
        return %removed

    block descend_or_missing(%slot: i64):
        %leaf: bool := #self.leaf
        branch %leaf ? return false : descend(%slot)

    block descend(%slot: i64):
        #alloc: Ptr<Allocator> := #map.alloc
        %actual: i64 = #self.ensure_min(%slot, #alloc)
        #child: Ptr<BTreeMapNode<K, V>> := #self.children[%actual]
        %removed: bool = #child.remove(#map, %key)
        #self.recount()
        return %removed

routine BTreeMap<K, V>::remove(#self: Ptr<BTreeMap<K, V>>, %key: K) -> bool
    block entry:
        #root: Ptr<BTreeMapNode<K, V>> := #self.root
        %empty: bool = #root == null
        branch %empty ? missing() : remove_root(#root)

    block remove_root(#root: Ptr<BTreeMapNode<K, V>>):
        %removed: bool = #root.remove(#self, %key)
        branch %removed ? after_remove(#root) : missing()

    block after_remove(#root: Ptr<BTreeMapNode<K, V>>):
        %length: i64 := #self.length
        #self.length = %length - 1
        %root_length: i64 := #root.length
        %empty_root: bool = %root_length == 0
        branch %empty_root ? maybe_shrink(#root) : return true

    block maybe_shrink(#root: Ptr<BTreeMapNode<K, V>>):
        %leaf: bool := #root.leaf
        branch %leaf ? clear_root(#root) : shrink(#root)

    block clear_root(#root: Ptr<BTreeMapNode<K, V>>):
        #alloc: Ptr<Allocator> := #self.alloc
        free<BTreeMapNode<K, V>>(#alloc, #root)
        #self.root = null
        return true

    block shrink(#root: Ptr<BTreeMapNode<K, V>>):
        #alloc: Ptr<Allocator> := #self.alloc
        #new_root: Ptr<BTreeMapNode<K, V>> := #root.children[0]
        free<BTreeMapNode<K, V>>(#alloc, #root)
        #self.root = #new_root
        return true

    block missing():
        return false

; Internal nodes store `length` separator keys and `length + 1` children.
routine BTreeMapNode<K, V>::free_recursive(#self: Ptr<BTreeMapNode<K, V>>, #alloc: Ptr<Allocator>) -> Void
    block entry:
        %leaf: bool := #self.leaf
        branch %leaf ? free_self() : free_children()

    block free_children():
        %length: i64 := #self.length
        %child_count: i64 = %length + 1
        jump child_loop(0, %child_count)

    block child_loop(%i: i64, %child_count: i64):
        %done: bool = sge(%i, %child_count)
        branch %done ? free_self() : free_child(%i, %child_count)

    block free_child(%i: i64, %child_count: i64):
        #child: Ptr<BTreeMapNode<K, V>> := #self.children[%i]
        #child.free_recursive(#alloc)
        jump child_loop(%i + 1, %child_count)

    block free_self():
        free<BTreeMapNode<K, V>>(#alloc, #self)
        return

routine BTreeMap<K, V>::free(#self: Ptr<BTreeMap<K, V>>) -> Void
    block entry:
        #root: Ptr<BTreeMapNode<K, V>> := #self.root
        %empty: bool = #root == null
        branch %empty ? reset() : free_root(#root)

    block free_root(#root: Ptr<BTreeMapNode<K, V>>):
        #alloc: Ptr<Allocator> := #self.alloc
        #root.free_recursive(#alloc)
        jump reset()

    block reset():
        #self.root = null
        #self.length = 0
        return
