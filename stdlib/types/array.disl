; Disl stdlib: Array<T, N> — fixed-size inline array
;
; Maps to LLVM IR [N x T].  Stored entirely inline — no heap allocation,
; no pointer indirection.  N is a compile-time constant I64.

@llvm("array")
struct Array<T, N>

; ── metadata ──────────────────────────────────────────────────────────────────

routine Array<T, N>::length() -> I64
    block entry():
        return N

; ── element access ────────────────────────────────────────────────────────────

routine Array<T, N>::get(#self: Ptr<Array<T, N>>, %index: I64) -> T
    block entry():
        %not_negative: Bool = sge<I64>(%index, 0)
        %before_end:   Bool = slt<I64>(%index, N)
        %in_bounds:    Bool = %not_negative & %before_end
        branch %in_bounds ? load(%index) : trap()

    block load(%index: I64):
        #base: Ptr<T> = bitcast<Ptr<Array<T, N>>, Ptr<T>>(#self)
        %value: T := #base[%index]
        return %value

routine Array<T, N>::set(#self: Ptr<Array<T, N>>, %index: I64, %value: T) -> Void
    block entry():
        %not_negative: Bool = sge<I64>(%index, 0)
        %before_end:   Bool = slt<I64>(%index, N)
        %in_bounds:    Bool = %not_negative & %before_end
        branch %in_bounds ? store(%index, %value) : trap()

    block store(%index: I64, %value: T):
        #base: Ptr<T> = bitcast<Ptr<Array<T, N>>, Ptr<T>>(#self)
        #base[%index] = %value
        return

; ── pointer to first element ──────────────────────────────────────────────────

routine Array<T, N>::as_ptr(#self: Ptr<Array<T, N>>) -> Ptr<T>
    block entry():
        #base: Ptr<T> = bitcast<Ptr<Array<T, N>>, Ptr<T>>(#self)
        return #base
