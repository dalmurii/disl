; Disl stdlib: F64 — 64-bit IEEE 754 floating-point
;
; Maps to LLVM IR double.

@llvm("double")
struct F64
conform Equal<F64>, Compare<F64>, Hash<F64>

; ── constants ─────────────────────────────────────────────────────────────────

const F64.INFINITY:     F64 = 0x7FF0000000000000  ; +inf bits
const F64.NEG_INFINITY: F64 = 0xFFF0000000000000  ; -inf bits
const F64.NAN:          F64 = 0x7FF8000000000000  ; canonical quiet NaN bits

; ── arithmetic ────────────────────────────────────────────────────────────────

routine F64.abs(%self: F64) -> Self
    block entry():
        %zero: F64 = 0.0
        %is_neg: Bool = %self.flt(%zero)
        %neg: F64 = fsub<F64>(%zero, %self)
        %result: F64 = %is_neg ? %neg : %self
        return(%result)

routine F64.min(%self: F64, %other: F64) -> Self
    block entry():
        %self_less: Bool = %self.flt(%other)
        %result: F64 = %self_less ? %self : %other
        return(%result)

routine F64.max(%self: F64, %other: F64) -> Self
    block entry():
        %self_more: Bool = %self.fgt(%other)
        %result: F64 = %self_more ? %self : %other
        return(%result)

routine F64.add(%self: F64, %other: F64) -> Self
    block entry():
        %r: F64 = fadd<F64>(%self, %other)
        return(%r)

routine F64.sub(%self: F64, %other: F64) -> Self
    block entry():
        %r: F64 = fsub<F64>(%self, %other)
        return(%r)

routine F64.mul(%self: F64, %other: F64) -> Self
    block entry():
        %r: F64 = fmul<F64>(%self, %other)
        return(%r)

; ── comparisons ───────────────────────────────────────────────────────────────

routine F64.lt(%self: F64, %other: F64) -> Bool
    block entry():
        %r: Bool = flt<F64>(%self, %other)
        return(%r)

routine F64.le(%self: F64, %other: F64) -> Bool
    block entry():
        %r: Bool = fle<F64>(%self, %other)
        return(%r)

routine F64.gt(%self: F64, %other: F64) -> Bool
    block entry():
        %r: Bool = fgt<F64>(%self, %other)
        return(%r)

routine F64.ge(%self: F64, %other: F64) -> Bool
    block entry():
        %r: Bool = fge<F64>(%self, %other)
        return(%r)

; ── division ──────────────────────────────────────────────────────────────────

routine F64.fdiv(%self: F64, %other: F64) -> Self
    block entry():
        %r: F64 = fdiv<F64>(%self, %other)
        return(%r)

; ── equality, ordering, hashing ───────────────────────────────────────────────

routine F64.eq(%self: F64, %other: F64) -> Bool
    block entry():
        %r: Bool = feq<F64>(%self, %other)
        return(%r)

routine F64.ne(%self: F64, %other: F64) -> Bool
    block entry():
        %r: Bool = fne<F64>(%self, %other)
        return(%r)

routine F64.compare(%self: F64, %other: F64) -> I32
    block entry():
        %lt: Bool = %self.flt(%other)
        branch %lt ? return(-1) : maybe_gt(%self, %other)

    block maybe_gt(%self: F64, %other: F64):
        %gt: Bool = %self.fgt(%other)
        branch %gt ? return(1) : return(0)

routine F64.hash(%self: F64) -> I64
    block entry():
        %bits: I64 = bitcast<F64, I64>(%self)
        %h: I64 = xxh64_hash_i64(%bits, 0)
        return(%h)

; ── generic conversions ───────────────────────────────────────────────────────

routine F64.fptrunc<To>(%self: F64) -> To
require To: typename
    block entry():
        %r: To = fptrunc<F64, To>(%self)
        return(%r)

routine F64.fptosi<To>(%self: F64) -> To
require To: typename
    block entry():
        %r: To = fptosi<F64, To>(%self)
        return(%r)

; ── named narrowing conversion ────────────────────────────────────────────────

routine F64.to_f32(%self: F64) -> F32
    block entry():
        %result: F32 = fptrunc<F64, F32>(%self)
        return(%result)

; ── float-to-int conversions (truncates toward zero) ─────────────────────────

routine F64.to_i32(%self: F64) -> I32
    block entry():
        %result: I32 = fptosi<F64, I32>(%self)
        return(%result)

routine F64.to_i64(%self: F64) -> I64
    block entry():
        %result: I64 = fptosi<F64, I64>(%self)
        return(%result)
