; Disl stdlib: F64 — 64-bit IEEE 754 floating-point
;
; Maps to LLVM IR double.

@llvm("double")
struct F64
conform Equal<F64>, Compare<F64>, Hash<F64>

; -- constants -----------------------------------------------------------------

const F64.INFINITY:     F64 = 0x7FF0000000000000  ; +inf bits
const F64.NEG_INFINITY: F64 = 0xFFF0000000000000  ; -inf bits
const F64.NAN:          F64 = 0x7FF8000000000000  ; canonical quiet NaN bits

; -- arithmetic ----------------------------------------------------------------

routine F64.abs(%self: Self) -> Self
    block entry():
        %zero: Self = 0.0
        %is_neg: Bool = %self.lt(%zero)
        %neg: Self = fsub<Self>(%zero, %self)
        %result: Self = %is_neg ? %neg : %self
        return(%result)

routine F64.min(%self: Self, %other: Self) -> Self
    block entry():
        %self_less: Bool = %self.lt(%other)
        %result: Self = %self_less ? %self : %other
        return(%result)

routine F64.max(%self: Self, %other: Self) -> Self
    block entry():
        %self_more: Bool = %self.gt(%other)
        %result: Self = %self_more ? %self : %other
        return(%result)

routine F64.add(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = fadd<Self>(%self, %other)
        return(%r)

routine F64.sub(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = fsub<Self>(%self, %other)
        return(%r)

routine F64.mul(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = fmul<Self>(%self, %other)
        return(%r)

; -- comparisons ---------------------------------------------------------------

routine F64.lt(%self: Self, %other: Self) -> Bool
    block entry():
        %r: Bool = flt<Self>(%self, %other)
        return(%r)

routine F64.le(%self: Self, %other: Self) -> Bool
    block entry():
        %r: Bool = fle<Self>(%self, %other)
        return(%r)

routine F64.gt(%self: Self, %other: Self) -> Bool
    block entry():
        %r: Bool = fgt<Self>(%self, %other)
        return(%r)

routine F64.ge(%self: Self, %other: Self) -> Bool
    block entry():
        %r: Bool = fge<Self>(%self, %other)
        return(%r)

; -- division ------------------------------------------------------------------

routine F64.fdiv(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = fdiv<Self>(%self, %other)
        return(%r)

; -- equality, ordering, hashing -----------------------------------------------

routine F64.eq(%self: Self, %other: Self) -> Bool
    block entry():
        %r: Bool = feq<Self>(%self, %other)
        return(%r)

routine F64.ne(%self: Self, %other: Self) -> Bool
    block entry():
        %r: Bool = fne<Self>(%self, %other)
        return(%r)

routine F64.compare(%self: Self, %other: Self) -> I32
    block entry():
        %lt: Bool = %self.lt(%other)
        branch %lt ? return(-1) : maybe_gt(%self, %other)

    block maybe_gt(%self: Self, %other: Self):
        %gt: Bool = %self.gt(%other)
        branch %gt ? return(1) : return(0)

routine F64.hash(%self: Self) -> I64
    block entry():
        %bits: I64 = bitcast<Self, I64>(%self)
        %h: I64 = xxh64_hash_i64(%bits, 0)
        return(%h)

; -- generic conversions -------------------------------------------------------

routine F64.fptrunc<To>(%self: Self) -> To
require To: typename
    block entry():
        %r: To = fptrunc<Self, To>(%self)
        return(%r)

routine F64.fptosi<To>(%self: Self) -> To
require To: typename
    block entry():
        %r: To = fptosi<Self, To>(%self)
        return(%r)

; -- named narrowing conversion ------------------------------------------------

routine F64.to_f32(%self: Self) -> F32
    block entry():
        %result: F32 = fptrunc<Self, F32>(%self)
        return(%result)

; -- float-to-int conversions (truncates toward zero) -------------------------

routine F64.to_i32(%self: Self) -> I32
    block entry():
        %result: I32 = fptosi<Self, I32>(%self)
        return(%result)

routine F64.to_i64(%self: Self) -> I64
    block entry():
        %result: I64 = fptosi<Self, I64>(%self)
        return(%result)
