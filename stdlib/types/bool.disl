; Disl stdlib: Bool — 1-bit boolean
;
; Maps to LLVM IR i1.

@llvm("i1")
struct Bool
conform Equal<Bool>, Hash<Bool>

; ── bitwise operations ────────────────────────────────────────────────────────

routine Bool.bitand(%self: Bool, %other: Bool) -> Bool
    block entry():
        %r: Bool = band<Bool>(%self, %other)
        return(%r)

routine Bool.bitor(%self: Bool, %other: Bool) -> Bool
    block entry():
        %r: Bool = bor<Bool>(%self, %other)
        return(%r)

routine Bool.bitxor(%self: Bool, %other: Bool) -> Bool
    block entry():
        %r: Bool = bxor<Bool>(%self, %other)
        return(%r)

routine Bool.bitnot(%self: Bool) -> Bool
    block entry():
        %r: Bool = bnot<Bool>(%self)
        return(%r)

; ── equality, hashing ─────────────────────────────────────────────────────────

routine Bool.eq(%self: Bool, %other: Bool) -> Bool
    block entry():
        %r: Bool = ieq<Bool>(%self, %other)
        return(%r)

routine Bool.ne(%self: Bool, %other: Bool) -> Bool
    block entry():
        %r: Bool = ine<Bool>(%self, %other)
        return(%r)


routine Bool.hash(%self: Bool) -> I64
    block entry():
        %v: I64 = %self.zext<I64>()
        %h: I64 = xxh64_hash_i64(%v, 0)
        return(%h)

; ── generic conversions ───────────────────────────────────────────────────────

routine Bool.zext<To>(%self: Bool) -> To
require To: typename
    block entry():
        %r: To = zext<Bool, To>(%self)
        return(%r)

; ── named conversions ─────────────────────────────────────────────────────────

routine Bool.to_i8(%self: Bool) -> I8
    block entry():
        %result: I8 = zext<Bool, I8>(%self)
        return(%result)

routine Bool.to_i32(%self: Bool) -> I32
    block entry():
        %result: I32 = zext<Bool, I32>(%self)
        return(%result)

routine Bool.to_i64(%self: Bool) -> I64
    block entry():
        %result: I64 = zext<Bool, I64>(%self)
        return(%result)
