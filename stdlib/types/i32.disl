; Disl stdlib: I32 — 32-bit signed integer
;
; Maps to LLVM IR i32.

@llvm("i32")
struct I32
conform Equal<I32>, Compare<I32>, Hash<I32>

; ── constants ─────────────────────────────────────────────────────────────────

const I32.MIN: I32 = -2147483648
const I32.MAX: I32 =  2147483647

; ── bit operations ────────────────────────────────────────────────────────────

routine I32.count_ones(%self: I32) -> I32
    block entry():
        %result: I32 = popcount<I32>(%self)
        return(%result)

routine I32.leading_zeros(%self: I32) -> I32
    block entry():
        %result: I32 = clz<I32>(%self, false)
        return(%result)

routine I32.trailing_zeros(%self: I32) -> I32
    block entry():
        %result: I32 = ctz<I32>(%self, false)
        return(%result)

routine I32.swap_bytes(%self: I32) -> I32
    block entry():
        %result: I32 = bswap<I32>(%self)
        return(%result)

; ── arithmetic ────────────────────────────────────────────────────────────────

routine I32.abs(%self: I32) -> I32
    block entry():
        %is_neg: Bool = %self.slt(0)
        %zero: I32 = 0
        %neg: I32 = %zero.sub(%self)
        %result: I32 = %is_neg ? %neg : %self
        return(%result)

routine I32.min(%self: I32, %other: I32) -> I32
    block entry():
        %less: Bool = %self.slt(%other)
        %result: I32 = %less ? %self : %other
        return(%result)

routine I32.max(%self: I32, %other: I32) -> I32
    block entry():
        %more: Bool = %self.sgt(%other)
        %result: I32 = %more ? %self : %other
        return(%result)

routine I32.add(%self: I32, %other: I32) -> I32
    block entry():
        %r: I32 = add<I32>(%self, %other)
        return(%r)

routine I32.sub(%self: I32, %other: I32) -> I32
    block entry():
        %r: I32 = sub<I32>(%self, %other)
        return(%r)

routine I32.mul(%self: I32, %other: I32) -> I32
    block entry():
        %r: I32 = mul<I32>(%self, %other)
        return(%r)

; ── bit shifts ────────────────────────────────────────────────────────────────

routine I32.shl(%self: I32, %n: I32) -> I32
    block entry():
        %r: I32 = shl<I32>(%self, %n)
        return(%r)

routine I32.lshr(%self: I32, %n: I32) -> I32
    block entry():
        %r: I32 = lshr<I32>(%self, %n)
        return(%r)

routine I32.ashr(%self: I32, %n: I32) -> I32
    block entry():
        %r: I32 = ashr<I32>(%self, %n)
        return(%r)

routine I32.rotl(%self: I32, %n: I32) -> I32
    block entry():
        %left: I32 = shl<I32>(%self, %n)
        %width: I32 = 32
        %comp: I32 = %width.sub(%n)
        %right: I32 = lshr<I32>(%self, %comp)
        %r: I32 = %left.bitor(%right)
        return(%r)

routine I32.rotr(%self: I32, %n: I32) -> I32
    block entry():
        %right: I32 = lshr<I32>(%self, %n)
        %width: I32 = 32
        %comp: I32 = %width.sub(%n)
        %left: I32 = shl<I32>(%self, %comp)
        %r: I32 = %left.bitor(%right)
        return(%r)

; ── bitwise operations ────────────────────────────────────────────────────────

routine I32.bitand(%self: I32, %other: I32) -> I32
    block entry():
        %r: I32 = band<I32>(%self, %other)
        return(%r)

routine I32.bitor(%self: I32, %other: I32) -> I32
    block entry():
        %r: I32 = bor<I32>(%self, %other)
        return(%r)

routine I32.bitxor(%self: I32, %other: I32) -> I32
    block entry():
        %r: I32 = bxor<I32>(%self, %other)
        return(%r)

routine I32.bitnot(%self: I32) -> I32
    block entry():
        %r: I32 = bnot<I32>(%self)
        return(%r)

; ── generic conversions ───────────────────────────────────────────────────────

routine I32.sext<To>(%self: I32) -> To
require To: typename
    block entry():
        %r: To = sext<I32, To>(%self)
        return(%r)

routine I32.zext<To>(%self: I32) -> To
require To: typename
    block entry():
        %r: To = zext<I32, To>(%self)
        return(%r)

routine I32.sitofp<To>(%self: I32) -> To
require To: typename
    block entry():
        %r: To = sitofp<I32, To>(%self)
        return(%r)

; ── signed comparisons ────────────────────────────────────────────────────────

routine I32.slt(%self: I32, %other: I32) -> Bool
    block entry():
        %r: Bool = slt<I32>(%self, %other)
        return(%r)

routine I32.sle(%self: I32, %other: I32) -> Bool
    block entry():
        %r: Bool = sle<I32>(%self, %other)
        return(%r)

routine I32.sgt(%self: I32, %other: I32) -> Bool
    block entry():
        %r: Bool = sgt<I32>(%self, %other)
        return(%r)

routine I32.sge(%self: I32, %other: I32) -> Bool
    block entry():
        %r: Bool = sge<I32>(%self, %other)
        return(%r)

; ── unsigned comparisons ──────────────────────────────────────────────────────

routine I32.ult(%self: I32, %other: I32) -> Bool
    block entry():
        %r: Bool = ult<I32>(%self, %other)
        return(%r)

routine I32.ule(%self: I32, %other: I32) -> Bool
    block entry():
        %r: Bool = ule<I32>(%self, %other)
        return(%r)

routine I32.ugt(%self: I32, %other: I32) -> Bool
    block entry():
        %r: Bool = ugt<I32>(%self, %other)
        return(%r)

routine I32.uge(%self: I32, %other: I32) -> Bool
    block entry():
        %r: Bool = uge<I32>(%self, %other)
        return(%r)

; ── integer division and remainder ────────────────────────────────────────────

routine I32.sdiv(%self: I32, %other: I32) -> I32
    block entry():
        %r: I32 = sdiv<I32>(%self, %other)
        return(%r)

routine I32.udiv(%self: I32, %other: I32) -> I32
    block entry():
        %r: I32 = udiv<I32>(%self, %other)
        return(%r)

routine I32.srem(%self: I32, %other: I32) -> I32
    block entry():
        %r: I32 = srem<I32>(%self, %other)
        return(%r)

routine I32.urem(%self: I32, %other: I32) -> I32
    block entry():
        %r: I32 = urem<I32>(%self, %other)
        return(%r)

; ── equality, ordering, hashing ───────────────────────────────────────────────

routine I32.eq(%self: I32, %other: I32) -> Bool
    block entry():
        %r: Bool = ieq<I32>(%self, %other)
        return(%r)

routine I32.ne(%self: I32, %other: I32) -> Bool
    block entry():
        %r: Bool = ine<I32>(%self, %other)
        return(%r)

routine I32.compare(%self: I32, %other: I32) -> I32
    block entry():
        %lt: Bool = %self.slt(%other)
        branch %lt ? return(-1) : maybe_gt(%self, %other)

    block maybe_gt(%self: I32, %other: I32):
        %gt: Bool = %self.sgt(%other)
        branch %gt ? return(1) : return(0)

routine I32.hash(%self: I32) -> I64
    block entry():
        %v: I64 = %self.zext<I64>()
        %h: I64 = xxh64_hash_i64(%v, 0)
        return(%h)

; ── narrowing conversions ─────────────────────────────────────────────────────

routine I32.to_i8(%self: I32) -> I8
    block entry():
        %result: I8 = trunc<I32, I8>(%self)
        return(%result)

routine I32.to_i16(%self: I32) -> I16
    block entry():
        %result: I16 = trunc<I32, I16>(%self)
        return(%result)

; ── widening conversions (sign-extending) ─────────────────────────────────────

routine I32.to_i64(%self: I32) -> I64
    block entry():
        %result: I64 = sext<I32, I64>(%self)
        return(%result)

; ── float conversions ─────────────────────────────────────────────────────────

routine I32.to_f32(%self: I32) -> F32
    block entry():
        %result: F32 = sitofp<I32, F32>(%self)
        return(%result)

routine I32.to_f64(%self: I32) -> F64
    block entry():
        %result: F64 = sitofp<I32, F64>(%self)
        return(%result)
