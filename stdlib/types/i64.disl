; Disl stdlib: I64 — 64-bit signed integer
;
; Maps to LLVM IR I64.

@llvm("I64")
struct I64
conform Equal<I64>, Compare<I64>, Hash<I64>

; -- constants -----------------------------------------------------------------

const I64.MIN: I64 = -9223372036854775808
const I64.MAX: I64 =  9223372036854775807

; -- bit operations ------------------------------------------------------------

routine I64.count_ones(%self: Self) -> Self
    block entry():
        %result: Self = popcount<Self>(%self)
        return(%result)

routine I64.leading_zeros(%self: Self) -> Self
    block entry():
        %result: Self = clz<Self>(%self, false)
        return(%result)

routine I64.trailing_zeros(%self: Self) -> Self
    block entry():
        %result: Self = ctz<Self>(%self, false)
        return(%result)

routine I64.swap_bytes(%self: Self) -> Self
    block entry():
        %result: Self = bswap<Self>(%self)
        return(%result)

; -- arithmetic ----------------------------------------------------------------

routine I64.abs(%self: Self) -> Self
    block entry():
        %is_neg: Bool = %self.slt(0)
        %zero: Self = 0
        %neg: Self = %zero.sub(%self)
        %result: Self = %is_neg ? %neg : %self
        return(%result)

routine I64.min(%self: Self, %other: Self) -> Self
    block entry():
        %less: Bool = %self.slt(%other)
        %result: Self = %less ? %self : %other
        return(%result)

routine I64.max(%self: Self, %other: Self) -> Self
    block entry():
        %more: Bool = %self.sgt(%other)
        %result: Self = %more ? %self : %other
        return(%result)

routine I64.add(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = add<Self>(%self, %other)
        return(%r)

routine I64.sub(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = sub<Self>(%self, %other)
        return(%r)

routine I64.mul(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = mul<Self>(%self, %other)
        return(%r)

; -- bit shifts ----------------------------------------------------------------

routine I64.shl(%self: Self, %n: Self) -> Self
    block entry():
        %r: Self = shl<Self>(%self, %n)
        return(%r)

routine I64.lshr(%self: Self, %n: Self) -> Self
    block entry():
        %r: Self = lshr<Self>(%self, %n)
        return(%r)

routine I64.ashr(%self: Self, %n: Self) -> Self
    block entry():
        %r: Self = ashr<Self>(%self, %n)
        return(%r)

routine I64.rotl(%self: Self, %n: Self) -> Self
    block entry():
        %left: Self = shl<Self>(%self, %n)
        %width: Self = 64
        %comp: Self = %width.sub(%n)
        %right: Self = lshr<Self>(%self, %comp)
        %r: Self = %left.bitor(%right)
        return(%r)

routine I64.rotr(%self: Self, %n: Self) -> Self
    block entry():
        %right: Self = lshr<Self>(%self, %n)
        %width: Self = 64
        %comp: Self = %width.sub(%n)
        %left: Self = shl<Self>(%self, %comp)
        %r: Self = %left.bitor(%right)
        return(%r)

; -- bitwise operations --------------------------------------------------------

routine I64.bitand(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = band<Self>(%self, %other)
        return(%r)

routine I64.bitor(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = bor<Self>(%self, %other)
        return(%r)

routine I64.bitxor(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = bxor<Self>(%self, %other)
        return(%r)

routine I64.bitnot(%self: Self) -> Self
    block entry():
        %r: Self = bnot<Self>(%self)
        return(%r)

; -- signed comparisons --------------------------------------------------------

routine I64.slt(%self: Self, %other: Self) -> Bool
    block entry():
        %r: Bool = slt<Self>(%self, %other)
        return(%r)

routine I64.sle(%self: Self, %other: Self) -> Bool
    block entry():
        %r: Bool = sle<Self>(%self, %other)
        return(%r)

routine I64.sgt(%self: Self, %other: Self) -> Bool
    block entry():
        %r: Bool = sgt<Self>(%self, %other)
        return(%r)

routine I64.sge(%self: Self, %other: Self) -> Bool
    block entry():
        %r: Bool = sge<Self>(%self, %other)
        return(%r)

; -- unsigned comparisons ------------------------------------------------------

routine I64.ult(%self: Self, %other: Self) -> Bool
    block entry():
        %r: Bool = ult<Self>(%self, %other)
        return(%r)

routine I64.ule(%self: Self, %other: Self) -> Bool
    block entry():
        %r: Bool = ule<Self>(%self, %other)
        return(%r)

routine I64.ugt(%self: Self, %other: Self) -> Bool
    block entry():
        %r: Bool = ugt<Self>(%self, %other)
        return(%r)

routine I64.uge(%self: Self, %other: Self) -> Bool
    block entry():
        %r: Bool = uge<Self>(%self, %other)
        return(%r)

; -- integer division and remainder --------------------------------------------

routine I64.sdiv(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = sdiv<Self>(%self, %other)
        return(%r)

routine I64.udiv(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = udiv<Self>(%self, %other)
        return(%r)

routine I64.srem(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = srem<Self>(%self, %other)
        return(%r)

routine I64.urem(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = urem<Self>(%self, %other)
        return(%r)

; -- equality, ordering, hashing -----------------------------------------------

routine I64.eq(%self: Self, %other: Self) -> Bool
    block entry():
        %r: Bool = ieq<Self>(%self, %other)
        return(%r)

routine I64.ne(%self: Self, %other: Self) -> Bool
    block entry():
        %r: Bool = ine<Self>(%self, %other)
        return(%r)

routine I64.compare(%self: Self, %other: Self) -> I32
    block entry():
        %lt: Bool = %self.slt(%other)
        branch %lt ? return(-1) : maybe_gt(%self, %other)

    block maybe_gt(%self: Self, %other: Self):
        %gt: Bool = %self.sgt(%other)
        branch %gt ? return(1) : return(0)

routine I64.hash(%self: Self) -> Self
    block entry():
        %h: Self = xxh64_hash_i64(%self, 0)
        return(%h)

; -- narrowing conversions -----------------------------------------------------

routine I64.to_i8(%self: Self) -> I8
    block entry():
        %result: I8 = %self.trunc<I8>()
        return(%result)

routine I64.to_i16(%self: Self) -> I16
    block entry():
        %result: I16 = %self.trunc<I16>()
        return(%result)

routine I64.to_i32(%self: Self) -> I32
    block entry():
        %result: I32 = %self.trunc<I32>()
        return(%result)

; -- float conversions ---------------------------------------------------------

routine I64.to_f32(%self: Self) -> F32
    block entry():
        %result: F32 = %self.sitofp<F32>()
        return(%result)

routine I64.to_f64(%self: Self) -> F64
    block entry():
        %result: F64 = %self.sitofp<F64>()
        return(%result)
