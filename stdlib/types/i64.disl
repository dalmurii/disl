; Disl stdlib: I64 — 64-bit signed integer
;
; Maps to LLVM IR I64.

@llvm("I64")
struct I64
conform Equal<I64>, Compare<I64>, Hash<I64>

; ── constants ─────────────────────────────────────────────────────────────────

const I64.MIN: I64 = -9223372036854775808
const I64.MAX: I64 =  9223372036854775807

; ── bit operations ────────────────────────────────────────────────────────────

routine I64.count_ones(%self: I64) -> Self
    block entry():
        %result: I64 = popcount<I64>(%self)
        return(%result)

routine I64.leading_zeros(%self: I64) -> Self
    block entry():
        %result: I64 = clz<I64>(%self, false)
        return(%result)

routine I64.trailing_zeros(%self: I64) -> Self
    block entry():
        %result: I64 = ctz<I64>(%self, false)
        return(%result)

routine I64.swap_bytes(%self: I64) -> Self
    block entry():
        %result: I64 = bswap<I64>(%self)
        return(%result)

; ── arithmetic ────────────────────────────────────────────────────────────────

routine I64.abs(%self: I64) -> Self
    block entry():
        %is_neg: Bool = %self.slt(0)
        %zero: I64 = 0
        %neg: I64 = %zero.sub(%self)
        %result: I64 = %is_neg ? %neg : %self
        return(%result)

routine I64.min(%self: I64, %other: I64) -> Self
    block entry():
        %less: Bool = %self.slt(%other)
        %result: I64 = %less ? %self : %other
        return(%result)

routine I64.max(%self: I64, %other: I64) -> Self
    block entry():
        %more: Bool = %self.sgt(%other)
        %result: I64 = %more ? %self : %other
        return(%result)

routine I64.add(%self: I64, %other: I64) -> Self
    block entry():
        %r: I64 = add<I64>(%self, %other)
        return(%r)

routine I64.sub(%self: I64, %other: I64) -> Self
    block entry():
        %r: I64 = sub<I64>(%self, %other)
        return(%r)

routine I64.mul(%self: I64, %other: I64) -> Self
    block entry():
        %r: I64 = mul<I64>(%self, %other)
        return(%r)

; ── bit shifts ────────────────────────────────────────────────────────────────

routine I64.shl(%self: I64, %n: I64) -> Self
    block entry():
        %r: I64 = shl<I64>(%self, %n)
        return(%r)

routine I64.lshr(%self: I64, %n: I64) -> Self
    block entry():
        %r: I64 = lshr<I64>(%self, %n)
        return(%r)

routine I64.ashr(%self: I64, %n: I64) -> Self
    block entry():
        %r: I64 = ashr<I64>(%self, %n)
        return(%r)

routine I64.rotl(%self: I64, %n: I64) -> Self
    block entry():
        %left: I64 = shl<I64>(%self, %n)
        %width: I64 = 64
        %comp: I64 = %width.sub(%n)
        %right: I64 = lshr<I64>(%self, %comp)
        %r: I64 = %left.bitor(%right)
        return(%r)

routine I64.rotr(%self: I64, %n: I64) -> Self
    block entry():
        %right: I64 = lshr<I64>(%self, %n)
        %width: I64 = 64
        %comp: I64 = %width.sub(%n)
        %left: I64 = shl<I64>(%self, %comp)
        %r: I64 = %left.bitor(%right)
        return(%r)

; ── bitwise operations ────────────────────────────────────────────────────────

routine I64.bitand(%self: I64, %other: I64) -> Self
    block entry():
        %r: I64 = band<I64>(%self, %other)
        return(%r)

routine I64.bitor(%self: I64, %other: I64) -> Self
    block entry():
        %r: I64 = bor<I64>(%self, %other)
        return(%r)

routine I64.bitxor(%self: I64, %other: I64) -> Self
    block entry():
        %r: I64 = bxor<I64>(%self, %other)
        return(%r)

routine I64.bitnot(%self: I64) -> Self
    block entry():
        %r: I64 = bnot<I64>(%self)
        return(%r)

; ── signed comparisons ────────────────────────────────────────────────────────

routine I64.slt(%self: I64, %other: I64) -> Bool
    block entry():
        %r: Bool = slt<I64>(%self, %other)
        return(%r)

routine I64.sle(%self: I64, %other: I64) -> Bool
    block entry():
        %r: Bool = sle<I64>(%self, %other)
        return(%r)

routine I64.sgt(%self: I64, %other: I64) -> Bool
    block entry():
        %r: Bool = sgt<I64>(%self, %other)
        return(%r)

routine I64.sge(%self: I64, %other: I64) -> Bool
    block entry():
        %r: Bool = sge<I64>(%self, %other)
        return(%r)

; ── unsigned comparisons ──────────────────────────────────────────────────────

routine I64.ult(%self: I64, %other: I64) -> Bool
    block entry():
        %r: Bool = ult<I64>(%self, %other)
        return(%r)

routine I64.ule(%self: I64, %other: I64) -> Bool
    block entry():
        %r: Bool = ule<I64>(%self, %other)
        return(%r)

routine I64.ugt(%self: I64, %other: I64) -> Bool
    block entry():
        %r: Bool = ugt<I64>(%self, %other)
        return(%r)

routine I64.uge(%self: I64, %other: I64) -> Bool
    block entry():
        %r: Bool = uge<I64>(%self, %other)
        return(%r)

; ── integer division and remainder ────────────────────────────────────────────

routine I64.sdiv(%self: I64, %other: I64) -> Self
    block entry():
        %r: I64 = sdiv<I64>(%self, %other)
        return(%r)

routine I64.udiv(%self: I64, %other: I64) -> Self
    block entry():
        %r: I64 = udiv<I64>(%self, %other)
        return(%r)

routine I64.srem(%self: I64, %other: I64) -> Self
    block entry():
        %r: I64 = srem<I64>(%self, %other)
        return(%r)

routine I64.urem(%self: I64, %other: I64) -> Self
    block entry():
        %r: I64 = urem<I64>(%self, %other)
        return(%r)

; ── equality, ordering, hashing ───────────────────────────────────────────────

routine I64.eq(%self: I64, %other: I64) -> Bool
    block entry():
        %r: Bool = ieq<I64>(%self, %other)
        return(%r)

routine I64.ne(%self: I64, %other: I64) -> Bool
    block entry():
        %r: Bool = ine<I64>(%self, %other)
        return(%r)

routine I64.compare(%self: I64, %other: I64) -> I32
    block entry():
        %lt: Bool = %self.slt(%other)
        branch %lt ? return(-1) : maybe_gt(%self, %other)

    block maybe_gt(%self: I64, %other: I64):
        %gt: Bool = %self.sgt(%other)
        branch %gt ? return(1) : return(0)

routine I64.hash(%self: I64) -> Self
    block entry():
        %h: I64 = xxh64_hash_i64(%self, 0)
        return(%h)

; ── narrowing conversions ─────────────────────────────────────────────────────

routine I64.to_i8(%self: I64) -> I8
    block entry():
        %result: I8 = %self.trunc<I8>()
        return(%result)

routine I64.to_i16(%self: I64) -> I16
    block entry():
        %result: I16 = %self.trunc<I16>()
        return(%result)

routine I64.to_i32(%self: I64) -> I32
    block entry():
        %result: I32 = %self.trunc<I32>()
        return(%result)

; ── float conversions ─────────────────────────────────────────────────────────

routine I64.to_f32(%self: I64) -> F32
    block entry():
        %result: F32 = %self.sitofp<F32>()
        return(%result)

routine I64.to_f64(%self: I64) -> F64
    block entry():
        %result: F64 = %self.sitofp<F64>()
        return(%result)
