; Disl stdlib: I16 — 16-bit signed integer
;
; Maps to LLVM IR i16.

@llvm("i16")
struct I16
conform Equal<I16>, Compare<I16>, Hash<I16>

; ── constants ─────────────────────────────────────────────────────────────────

const I16.MIN: I16 = -32768
const I16.MAX: I16 =  32767

; ── bit operations ────────────────────────────────────────────────────────────

routine I16.count_ones(%self: I16) -> I16
    block entry():
        %result: I16 = popcount<I16>(%self)
        return(%result)

routine I16.leading_zeros(%self: I16) -> I16
    block entry():
        %result: I16 = clz<I16>(%self, false)
        return(%result)

routine I16.trailing_zeros(%self: I16) -> I16
    block entry():
        %result: I16 = ctz<I16>(%self, false)
        return(%result)

routine I16.swap_bytes(%self: I16) -> I16
    block entry():
        %result: I16 = bswap<I16>(%self)
        return(%result)

; ── arithmetic ────────────────────────────────────────────────────────────────

routine I16.abs(%self: I16) -> I16
    block entry():
        %is_neg: Bool = %self.slt(0)
        %zero: I16 = 0
        %neg: I16 = %zero.sub(%self)
        %result: I16 = %is_neg ? %neg : %self
        return(%result)

routine I16.min(%self: I16, %other: I16) -> I16
    block entry():
        %less: Bool = %self.slt(%other)
        %result: I16 = %less ? %self : %other
        return(%result)

routine I16.max(%self: I16, %other: I16) -> I16
    block entry():
        %more: Bool = %self.sgt(%other)
        %result: I16 = %more ? %self : %other
        return(%result)

routine I16.add(%self: I16, %other: I16) -> I16
    block entry():
        %r: I16 = add<I16>(%self, %other)
        return(%r)

routine I16.sub(%self: I16, %other: I16) -> I16
    block entry():
        %r: I16 = sub<I16>(%self, %other)
        return(%r)

routine I16.mul(%self: I16, %other: I16) -> I16
    block entry():
        %r: I16 = mul<I16>(%self, %other)
        return(%r)

; ── bit shifts ────────────────────────────────────────────────────────────────

routine I16.shl(%self: I16, %n: I16) -> I16
    block entry():
        %r: I16 = shl<I16>(%self, %n)
        return(%r)

routine I16.lshr(%self: I16, %n: I16) -> I16
    block entry():
        %r: I16 = lshr<I16>(%self, %n)
        return(%r)

routine I16.ashr(%self: I16, %n: I16) -> I16
    block entry():
        %r: I16 = ashr<I16>(%self, %n)
        return(%r)

routine I16.rotl(%self: I16, %n: I16) -> I16
    block entry():
        %left: I16 = shl<I16>(%self, %n)
        %width: I16 = 16
        %comp: I16 = %width.sub(%n)
        %right: I16 = lshr<I16>(%self, %comp)
        %r: I16 = %left.bitor(%right)
        return(%r)

routine I16.rotr(%self: I16, %n: I16) -> I16
    block entry():
        %right: I16 = lshr<I16>(%self, %n)
        %width: I16 = 16
        %comp: I16 = %width.sub(%n)
        %left: I16 = shl<I16>(%self, %comp)
        %r: I16 = %left.bitor(%right)
        return(%r)

; ── bitwise operations ────────────────────────────────────────────────────────

routine I16.bitand(%self: I16, %other: I16) -> I16
    block entry():
        %r: I16 = band<I16>(%self, %other)
        return(%r)

routine I16.bitor(%self: I16, %other: I16) -> I16
    block entry():
        %r: I16 = bor<I16>(%self, %other)
        return(%r)

routine I16.bitxor(%self: I16, %other: I16) -> I16
    block entry():
        %r: I16 = bxor<I16>(%self, %other)
        return(%r)

routine I16.bitnot(%self: I16) -> I16
    block entry():
        %r: I16 = bnot<I16>(%self)
        return(%r)

; ── signed comparisons ────────────────────────────────────────────────────────

routine I16.slt(%self: I16, %other: I16) -> Bool
    block entry():
        %r: Bool = slt<I16>(%self, %other)
        return(%r)

routine I16.sle(%self: I16, %other: I16) -> Bool
    block entry():
        %r: Bool = sle<I16>(%self, %other)
        return(%r)

routine I16.sgt(%self: I16, %other: I16) -> Bool
    block entry():
        %r: Bool = sgt<I16>(%self, %other)
        return(%r)

routine I16.sge(%self: I16, %other: I16) -> Bool
    block entry():
        %r: Bool = sge<I16>(%self, %other)
        return(%r)

; ── unsigned comparisons ──────────────────────────────────────────────────────

routine I16.ult(%self: I16, %other: I16) -> Bool
    block entry():
        %r: Bool = ult<I16>(%self, %other)
        return(%r)

routine I16.ule(%self: I16, %other: I16) -> Bool
    block entry():
        %r: Bool = ule<I16>(%self, %other)
        return(%r)

routine I16.ugt(%self: I16, %other: I16) -> Bool
    block entry():
        %r: Bool = ugt<I16>(%self, %other)
        return(%r)

routine I16.uge(%self: I16, %other: I16) -> Bool
    block entry():
        %r: Bool = uge<I16>(%self, %other)
        return(%r)

; ── integer division and remainder ────────────────────────────────────────────

routine I16.sdiv(%self: I16, %other: I16) -> I16
    block entry():
        %r: I16 = sdiv<I16>(%self, %other)
        return(%r)

routine I16.udiv(%self: I16, %other: I16) -> I16
    block entry():
        %r: I16 = udiv<I16>(%self, %other)
        return(%r)

routine I16.srem(%self: I16, %other: I16) -> I16
    block entry():
        %r: I16 = srem<I16>(%self, %other)
        return(%r)

routine I16.urem(%self: I16, %other: I16) -> I16
    block entry():
        %r: I16 = urem<I16>(%self, %other)
        return(%r)

; ── equality, ordering, hashing ───────────────────────────────────────────────

routine I16.eq(%self: I16, %other: I16) -> Bool
    block entry():
        %r: Bool = ieq<I16>(%self, %other)
        return(%r)

routine I16.ne(%self: I16, %other: I16) -> Bool
    block entry():
        %r: Bool = ine<I16>(%self, %other)
        return(%r)

routine I16.compare(%self: I16, %other: I16) -> I32
    block entry():
        %lt: Bool = %self.slt(%other)
        branch %lt ? return(-1) : maybe_gt(%self, %other)

    block maybe_gt(%self: I16, %other: I16):
        %gt: Bool = %self.sgt(%other)
        branch %gt ? return(1) : return(0)

routine I16.hash(%self: I16) -> I64
    block entry():
        %h: I64 = xxh64_hash_i64(%self.zext<I64>(), 0)
        return(%h)

; ── narrowing conversions ─────────────────────────────────────────────────────

routine I16.to_i8(%self: I16) -> I8
    block entry():
        %result: I8 = trunc<I16, I8>(%self)
        return(%result)

; ── widening conversions (sign-extending) ─────────────────────────────────────

routine I16.to_i32(%self: I16) -> I32
    block entry():
        %result: I32 = sext<I16, I32>(%self)
        return(%result)

routine I16.to_i64(%self: I16) -> I64
    block entry():
        %result: I64 = sext<I16, I64>(%self)
        return(%result)

routine I16.to_u32(%self: I16) -> I32
    block entry():
        %result: I32 = zext<I16, I32>(%self)
        return(%result)

routine I16.to_u64(%self: I16) -> I64
    block entry():
        %result: I64 = zext<I16, I64>(%self)
        return(%result)
