; Disl stdlib: I16 — 16-bit signed integer
;
; Maps to LLVM IR i16.

@llvm("i16")
struct I16
conform Equal<I16>, Compare<I16>, Hash<I16>

; ── constants ─────────────────────────────────────────────────────────────────

const I16.MIN: I16 = -32768
const I16.MAX: I16 =  32767

; ── bit operations ────────────────────────────────────────────────────────────

routine I16.count_ones(%self: Self) -> Self
    block entry():
        %result: Self = popcount<Self>(%self)
        return(%result)

routine I16.leading_zeros(%self: Self) -> Self
    block entry():
        %result: Self = clz<Self>(%self, false)
        return(%result)

routine I16.trailing_zeros(%self: Self) -> Self
    block entry():
        %result: Self = ctz<Self>(%self, false)
        return(%result)

routine I16.swap_bytes(%self: Self) -> Self
    block entry():
        %result: Self = bswap<Self>(%self)
        return(%result)

; ── arithmetic ────────────────────────────────────────────────────────────────

routine I16.abs(%self: Self) -> Self
    block entry():
        %is_neg: Bool = %self.slt(0)
        %zero: Self = 0
        %neg: Self = %zero.sub(%self)
        %result: Self = %is_neg ? %neg : %self
        return(%result)

routine I16.min(%self: Self, %other: Self) -> Self
    block entry():
        %less: Bool = %self.slt(%other)
        %result: Self = %less ? %self : %other
        return(%result)

routine I16.max(%self: Self, %other: Self) -> Self
    block entry():
        %more: Bool = %self.sgt(%other)
        %result: Self = %more ? %self : %other
        return(%result)

routine I16.add(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = add<Self>(%self, %other)
        return(%r)

routine I16.sub(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = sub<Self>(%self, %other)
        return(%r)

routine I16.mul(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = mul<Self>(%self, %other)
        return(%r)

; ── bit shifts ────────────────────────────────────────────────────────────────

routine I16.shl(%self: Self, %n: Self) -> Self
    block entry():
        %r: Self = shl<Self>(%self, %n)
        return(%r)

routine I16.lshr(%self: Self, %n: Self) -> Self
    block entry():
        %r: Self = lshr<Self>(%self, %n)
        return(%r)

routine I16.ashr(%self: Self, %n: Self) -> Self
    block entry():
        %r: Self = ashr<Self>(%self, %n)
        return(%r)

routine I16.rotl(%self: Self, %n: Self) -> Self
    block entry():
        %left: Self = shl<Self>(%self, %n)
        %width: Self = 16
        %comp: Self = %width.sub(%n)
        %right: Self = lshr<Self>(%self, %comp)
        %r: Self = %left.bitor(%right)
        return(%r)

routine I16.rotr(%self: Self, %n: Self) -> Self
    block entry():
        %right: Self = lshr<Self>(%self, %n)
        %width: Self = 16
        %comp: Self = %width.sub(%n)
        %left: Self = shl<Self>(%self, %comp)
        %r: Self = %left.bitor(%right)
        return(%r)

; ── bitwise operations ────────────────────────────────────────────────────────

routine I16.bitand(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = band<Self>(%self, %other)
        return(%r)

routine I16.bitor(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = bor<Self>(%self, %other)
        return(%r)

routine I16.bitxor(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = bxor<Self>(%self, %other)
        return(%r)

routine I16.bitnot(%self: Self) -> Self
    block entry():
        %r: Self = bnot<Self>(%self)
        return(%r)

; ── signed comparisons ────────────────────────────────────────────────────────

routine I16.slt(%self: Self, %other: Self) -> Bool
    block entry():
        %r: Bool = slt<Self>(%self, %other)
        return(%r)

routine I16.sle(%self: Self, %other: Self) -> Bool
    block entry():
        %r: Bool = sle<Self>(%self, %other)
        return(%r)

routine I16.sgt(%self: Self, %other: Self) -> Bool
    block entry():
        %r: Bool = sgt<Self>(%self, %other)
        return(%r)

routine I16.sge(%self: Self, %other: Self) -> Bool
    block entry():
        %r: Bool = sge<Self>(%self, %other)
        return(%r)

; ── unsigned comparisons ──────────────────────────────────────────────────────

routine I16.ult(%self: Self, %other: Self) -> Bool
    block entry():
        %r: Bool = ult<Self>(%self, %other)
        return(%r)

routine I16.ule(%self: Self, %other: Self) -> Bool
    block entry():
        %r: Bool = ule<Self>(%self, %other)
        return(%r)

routine I16.ugt(%self: Self, %other: Self) -> Bool
    block entry():
        %r: Bool = ugt<Self>(%self, %other)
        return(%r)

routine I16.uge(%self: Self, %other: Self) -> Bool
    block entry():
        %r: Bool = uge<Self>(%self, %other)
        return(%r)

; ── integer division and remainder ────────────────────────────────────────────

routine I16.sdiv(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = sdiv<Self>(%self, %other)
        return(%r)

routine I16.udiv(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = udiv<Self>(%self, %other)
        return(%r)

routine I16.srem(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = srem<Self>(%self, %other)
        return(%r)

routine I16.urem(%self: Self, %other: Self) -> Self
    block entry():
        %r: Self = urem<Self>(%self, %other)
        return(%r)

; ── equality, ordering, hashing ───────────────────────────────────────────────

routine I16.eq(%self: Self, %other: Self) -> Bool
    block entry():
        %r: Bool = ieq<Self>(%self, %other)
        return(%r)

routine I16.ne(%self: Self, %other: Self) -> Bool
    block entry():
        %r: Bool = ine<Self>(%self, %other)
        return(%r)

routine I16.compare(%self: Self, %other: Self) -> I32
    block entry():
        %lt: Bool = %self.slt(%other)
        branch %lt ? return(-1) : maybe_gt(%self, %other)

    block maybe_gt(%self: Self, %other: Self):
        %gt: Bool = %self.sgt(%other)
        branch %gt ? return(1) : return(0)

routine I16.hash(%self: Self) -> I64
    block entry():
        %h: I64 = xxh64_hash_i64(%self.zext<I64>(), 0)
        return(%h)

; ── narrowing conversions ─────────────────────────────────────────────────────

routine I16.to_i8(%self: Self) -> I8
    block entry():
        %result: I8 = trunc<Self, I8>(%self)
        return(%result)

; ── widening conversions (sign-extending) ─────────────────────────────────────

routine I16.to_i32(%self: Self) -> I32
    block entry():
        %result: I32 = sext<Self, I32>(%self)
        return(%result)

routine I16.to_i64(%self: Self) -> I64
    block entry():
        %result: I64 = sext<Self, I64>(%self)
        return(%result)

routine I16.to_u32(%self: Self) -> I32
    block entry():
        %result: I32 = zext<Self, I32>(%self)
        return(%result)

routine I16.to_u64(%self: Self) -> I64
    block entry():
        %result: I64 = zext<Self, I64>(%self)
        return(%result)
