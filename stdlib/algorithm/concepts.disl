; Disl stdlib algorithm concepts
;
; Concepts are compile-time required routine sets. They do not imply a runtime
; vtable by themselves; a generic routine names an Ops type and constrains it
; with one of these concepts.

concept Equal<T>
    routine T.equals(%a: T, %b: T) -> Bool

concept Hash<T>
    routine T.hash(%value: T) -> I64

concept HashEqual<T>
    require Equal<T>
    require Hash<T>

concept Compare<T>
    ; Return < 0 when a < b, 0 when a == b, and > 0 when a > b.
    routine T.compare(%a: T, %b: T) -> I32

concept Priority<T>
    ; Return true when a should be closer to the top than b.
    routine T.less(%a: T, %b: T) -> Bool

concept Iterator<T, Iter>
    ; Advance and return the next element, or Option<T>.none() when exhausted.
    ; next() mutates the iterator state, so #self is a pointer.
    routine Iter.next(#self: Ptr<Iter>) -> Option<T>
