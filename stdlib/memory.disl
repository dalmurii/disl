; Disl stdlib: Allocator pattern and memory routines
;
; The Allocator struct is a manual vtable: callers pass Ptr<Allocator> to any
; routine that performs heap allocation.  make_heap_allocator() returns an
; Allocator backed by libc malloc / realloc / free.
;
; Generic routines (alloc, realloc, free, zero, copy) form the prelude memory
; surface used by every collection.

; ============================================================
; C FFI: libc memory
; ============================================================

@[external("c"), callconv("c"), symbol("malloc")]
routine c_malloc(%size: I64) -> Ptr

@[external("c"), callconv("c"), symbol("realloc")]
routine c_realloc(#Ptr: Ptr, %size: I64) -> Ptr

@[external("c"), callconv("c"), symbol("free")]
routine c_free(#Ptr: Ptr) -> Void

@[external("c"), callconv("c"), symbol("memcpy")]
routine c_memcpy(#dst: Ptr, #src: Ptr, %size: I64) -> Void

@[external("c"), callconv("c"), symbol("memset")]
routine c_memset(#Ptr: Ptr, %value: I32, %size: I64) -> Void

; ============================================================
; Allocator struct
; ============================================================

struct Allocator
    alloc_fn:   Callable<@callconv("c"), (Ptr, I64), Ptr>
    realloc_fn: Callable<@callconv("c"), (Ptr, Ptr, I64), Ptr>
    free_fn:    Callable<@callconv("c"), (Ptr, Ptr), Void>
    state: Ptr

; ============================================================
; Heap allocator backend (libc wrappers matching Allocator callbacks)
; ============================================================

@callconv("c")
routine heap_alloc_fn(#state: Ptr, %size: I64) -> Ptr
    block entry:
        #result: Ptr = c_malloc(%size)
        return(#result)

@callconv("c")
routine heap_realloc_fn(#state: Ptr, #old_Ptr: Ptr, %size: I64) -> Ptr
    block entry:
        #result: Ptr = c_realloc(#old_Ptr, %size)
        return(#result)

@callconv("c")
routine heap_free_fn(#state: Ptr, #Ptr: Ptr) -> Void
    block entry:
        c_free(#Ptr)
        return()

; ============================================================
; Allocator factory
; ============================================================

routine make_heap_allocator() -> Allocator
    block entry:
        %alloc: Allocator = Allocator {
            alloc_fn:   heap_alloc_fn,
            realloc_fn: heap_realloc_fn,
            free_fn:    heap_free_fn,
            state:      null
        }
        return(%alloc)

; ============================================================
; Generic memory routines (prelude surface)
; ============================================================

routine alloc<T>(#alloc: Ptr<Allocator>, %count: I64) -> Ptr<T>
    block entry:
        %size: I64 = sizeof<T> * %count
        #raw: Ptr = #alloc.alloc_fn(#alloc.state, %size)
        #typed: Ptr<T> = bitcast<Ptr, Ptr<T>>(#raw)
        return(#typed)

routine realloc<T>(#alloc: Ptr<Allocator>, #Ptr: Ptr<T>, %new_count: I64) -> Ptr<T>
    block entry:
        %size: I64 = sizeof<T> * %new_count
        #raw_old: Ptr = bitcast<Ptr<T>, Ptr>(#Ptr)
        #raw: Ptr = #alloc.realloc_fn(#alloc.state, #raw_old, %size)
        #typed: Ptr<T> = bitcast<Ptr, Ptr<T>>(#raw)
        return(#typed)

routine free<T>(#alloc: Ptr<Allocator>, #Ptr: Ptr<T>) -> Void
    block entry:
        #raw: Ptr = bitcast<Ptr<T>, Ptr>(#Ptr)
        #alloc.free_fn(#alloc.state, #raw)
        return()

routine zero<T>(#Ptr: Ptr<T>, %count: I64) -> Void
    block entry:
        %size: I64 = sizeof<T> * %count
        #raw: Ptr = bitcast<Ptr<T>, Ptr>(#Ptr)
        c_memset(#raw, 0, %size)
        return()

routine copy<T>(#dst: Ptr<T>, #src: Ptr<T>, %count: I64) -> Void
    block entry:
        %size: I64 = sizeof<T> * %count
        #raw_dst: Ptr = bitcast<Ptr<T>, Ptr>(#dst)
        #raw_src: Ptr = bitcast<Ptr<T>, Ptr>(#src)
        c_memcpy(#raw_dst, #raw_src, %size)
        return()
