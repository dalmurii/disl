; Disl playground: "union" via comptime-sized struct
;
; Disl has no `union` keyword. The same effect comes from declaring a struct
; whose only field is an aligned byte buffer sized to fit the largest member.
; `sizeof<T>()`, `alignof<T>()`, and `max(...)` are comptime-reducible, so the
; compiler still picks up the right layout at monomorphization time.
;
;     struct N
;         @aligned(max(alignof<A>(), alignof<B>()))
;         storage: Array<I8, max(sizeof<A>(), sizeof<B>())>
;
; Access is always an explicit bitcast through the storage field. Whoever
; owns the data is responsible for knowing which view is currently active.

@[external("c"), callconv("c"), symbol("printf")]
routine c_printf_int(#fmt: Ptr<I8>, %x: I64) -> I32

@[external("c"), callconv("c"), symbol("printf")]
routine c_printf_float(#fmt: Ptr<I8>, %x: F64) -> I32

; ============================================================
; A generic two-way overlay. Stdlib could ship UnionTwo / UnionThree, or
; users can inline the same shape — there is no special type-form involved.
; ============================================================

struct UnionTwo<A, B>
    @aligned(max(alignof<A>(), alignof<B>()))
    storage: Array<I8, max(sizeof<A>(), sizeof<B>())>

; ============================================================
; Section 1: Manual tagged sum type
;
; Result<I64, I32> — either an Ok value or an error code. The tag lives
; in the wrapping struct; the overlay carries the payload bytes.
; ============================================================

enum ResultTag: I32
    Ok:  0
    Err: 1

struct Result
    tag: ResultTag
    payload: UnionTwo<I64, I32>

routine Result.ok(%value: I64) -> Self
    block entry():
        #payload_buf: Ptr<UnionTwo<I64, I32>> = alloca<UnionTwo<I64, I32>>
        #ok_view: Ptr<I64> = bitcast<Ptr<UnionTwo<I64, I32>>, Ptr<I64>>(#payload_buf)
        #ok_view = %value
        %payload: UnionTwo<I64, I32> := #payload_buf
        %r: Self = Self {
            tag: ResultTag.Ok,
            payload: %payload
        }
        return(%r)

routine Result.err(%code: I32) -> Self
    block entry():
        #payload_buf: Ptr<UnionTwo<I64, I32>> = alloca<UnionTwo<I64, I32>>
        #err_view: Ptr<I32> = bitcast<Ptr<UnionTwo<I64, I32>>, Ptr<I32>>(#payload_buf)
        #err_view = %code
        %payload: UnionTwo<I64, I32> := #payload_buf
        %r: Self = Self {
            tag: ResultTag.Err,
            payload: %payload
        }
        return(%r)

; Caller checks the tag explicitly, then bitcasts to the active view.
routine Result.print(#self: Ptr<Self>) -> Void
    block entry():
        %tag: ResultTag := #self.tag
        switch %tag:
            ResultTag.Ok -> print_ok()
            ResultTag.Err -> print_err()
            _ -> unreachable

    block print_ok():
        #payload: Ptr<UnionTwo<I64, I32>> = #self.payload
        #ok_view: Ptr<I64> = bitcast<Ptr<UnionTwo<I64, I32>>, Ptr<I64>>(#payload)
        %v: I64 := #ok_view
        c_printf_int("Ok(%lld)\n", %v)
        return()

    block print_err():
        #payload: Ptr<UnionTwo<I64, I32>> = #self.payload
        #err_view: Ptr<I32> = bitcast<Ptr<UnionTwo<I64, I32>>, Ptr<I32>>(#payload)
        %code: I32 := #err_view
        %code64: I64 = sext<I32, I64>(%code)
        c_printf_int("Err(%lld)\n", %code64)
        return()

; ============================================================
; Section 2: C ABI overlay — Number that is either int-shaped or float-shaped
;
; This is the pattern for `union sigval`, sockaddr families, or any C API
; that hands you a union by value. Disl declares the storage struct; thin
; wrappers name the views so callers don't sprinkle bitcasts at every site.
; ============================================================

struct Number
    @aligned(max(alignof<I64>(), alignof<F64>()))
    storage: Array<I8, max(sizeof<I64>(), sizeof<F64>())>

routine Number.from_int(%n: I64) -> Self
    block entry():
        #buf: Ptr<Number> = alloca<Number>
        #int_view: Ptr<I64> = bitcast<Ptr<Number>, Ptr<I64>>(#buf)
        #int_view = %n
        %u: Number := #buf
        return(%u)

routine Number.from_float(%f: F64) -> Self
    block entry():
        #buf: Ptr<Number> = alloca<Number>
        #float_view: Ptr<F64> = bitcast<Ptr<Number>, Ptr<F64>>(#buf)
        #float_view = %f
        %u: Number := #buf
        return(%u)

routine Number.as_int(#self: Ptr<Self>) -> I64
    block entry():
        #view: Ptr<I64> = bitcast<Ptr<Number>, Ptr<I64>>(#self)
        %n: I64 := #view
        return(%n)

routine Number.as_float(#self: Ptr<Self>) -> F64
    block entry():
        #view: Ptr<F64> = bitcast<Ptr<Number>, Ptr<F64>>(#self)
        %f: F64 := #view
        return(%f)

; ============================================================
; main
; ============================================================

routine main() -> I32
    block entry():
        ; --- tagged result ---
        %ok: Result = Result.ok(42)
        %err: Result = Result.err(-5)

        #ok_ptr: Ptr<Result> = alloca<Result>([%ok])
        #err_ptr: Ptr<Result> = alloca<Result>([%err])
        #ok_ptr.print()
        #err_ptr.print()

        ; --- C ABI overlay ---
        %as_int: Number = Number.from_int(7)
        %as_float: Number = Number.from_float(3.14)

        #int_ptr: Ptr<Number> = alloca<Number>([%as_int])
        #flt_ptr: Ptr<Number> = alloca<Number>([%as_float])

        c_printf_int("Number int view: %lld\n", #int_ptr.as_int())
        c_printf_float("Number float view: %f\n", #flt_ptr.as_float())

        return(0)