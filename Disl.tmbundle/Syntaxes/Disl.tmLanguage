<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>name</key>
    <string>Disl</string>
    <key>scopeName</key>
    <string>source.disl</string>
    <key>fileTypes</key>
    <array>
        <string>disl</string>
    </array>
    <key>patterns</key>
    <array>
        <dict><key>include</key><string>#comment</string></dict>
        <dict><key>include</key><string>#attribute</string></dict>
        <dict><key>include</key><string>#string</string></dict>
        <dict><key>include</key><string>#char</string></dict>
        <dict><key>include</key><string>#number</string></dict>
        <dict><key>include</key><string>#routine-decl</string></dict>
        <dict><key>include</key><string>#block-decl</string></dict>
        <dict><key>include</key><string>#struct-decl</string></dict>
        <dict><key>include</key><string>#enum-decl</string></dict>
        <dict><key>include</key><string>#concept-decl</string></dict>
        <dict><key>include</key><string>#const-decl</string></dict>
        <dict><key>include</key><string>#keywords-control</string></dict>
        <dict><key>include</key><string>#keywords-declaration</string></dict>
        <dict><key>include</key><string>#keywords-other</string></dict>
        <dict><key>include</key><string>#builtin-types</string></dict>
        <dict><key>include</key><string>#sigil-self</string></dict>
        <dict><key>include</key><string>#sigil-ssa</string></dict>
        <dict><key>include</key><string>#sigil-ptr</string></dict>
        <dict><key>include</key><string>#operators</string></dict>
    </array>
    <key>repository</key>
    <dict>

        <!-- ; line comment -->
        <key>comment</key>
        <dict>
            <key>name</key>
            <string>comment.line.semicolon.disl</string>
            <key>match</key>
            <string>;.*$</string>
        </dict>

        <!-- @[key("val"), key] and bare @word attributes -->
        <key>attribute</key>
        <dict>
            <key>name</key>
            <string>meta.attribute.disl</string>
            <key>begin</key>
            <string>@\[</string>
            <key>beginCaptures</key>
            <dict>
                <key>0</key>
                <dict>
                    <key>name</key>
                    <string>punctuation.definition.attribute.disl</string>
                </dict>
            </dict>
            <key>end</key>
            <string>\]</string>
            <key>endCaptures</key>
            <dict>
                <key>0</key>
                <dict>
                    <key>name</key>
                    <string>punctuation.definition.attribute.disl</string>
                </dict>
            </dict>
            <key>patterns</key>
            <array>
                <dict>
                    <key>match</key>
                    <string>\b([a-zA-Z_][a-zA-Z0-9_]*)\s*(?=\(|,|\])</string>
                    <key>captures</key>
                    <dict>
                        <key>1</key>
                        <dict><key>name</key><string>entity.other.attribute-name.disl</string></dict>
                    </dict>
                </dict>
                <dict><key>include</key><string>#string</string></dict>
                <dict><key>include</key><string>#comment</string></dict>
            </array>
        </dict>

        <!-- "string literals" -->
        <key>string</key>
        <dict>
            <key>name</key>
            <string>string.quoted.double.disl</string>
            <key>begin</key>
            <string>"</string>
            <key>end</key>
            <string>"</string>
            <key>patterns</key>
            <array>
                <dict>
                    <key>name</key>
                    <string>constant.character.escape.disl</string>
                    <key>match</key>
                    <string>\\(n|t|r|0|\\|"|'|x[0-9a-fA-F]{2}|u\{[0-9a-fA-F]+\})</string>
                </dict>
            </array>
        </dict>

        <!-- b'A' b'\xFF' (I8) and 'A' '\u{…}' (I32) char literals -->
        <key>char</key>
        <dict>
            <key>name</key>
            <string>string.quoted.single.disl</string>
            <key>match</key>
            <string>b?'(\\(n|t|r|0|\\|'|x[0-9a-fA-F]{2}|u\{[0-9a-fA-F]+\})|[^\\'])'</string>
        </dict>

        <!-- numeric literals: 0xFF 0b1010 0o17 3.14 1.5e10 42 -->
        <key>number</key>
        <dict>
            <key>patterns</key>
            <array>
                <dict>
                    <key>name</key>
                    <string>constant.numeric.hex.disl</string>
                    <key>match</key>
                    <string>\b0x[0-9a-fA-F]+\b</string>
                </dict>
                <dict>
                    <key>name</key>
                    <string>constant.numeric.binary.disl</string>
                    <key>match</key>
                    <string>\b0b[01]+\b</string>
                </dict>
                <dict>
                    <key>name</key>
                    <string>constant.numeric.octal.disl</string>
                    <key>match</key>
                    <string>\b0o[0-7]+\b</string>
                </dict>
                <dict>
                    <key>name</key>
                    <string>constant.numeric.float.disl</string>
                    <key>match</key>
                    <string>\b[0-9]+\.[0-9]+([eE][+-]?[0-9]+)?\b</string>
                </dict>
                <dict>
                    <key>name</key>
                    <string>constant.numeric.integer.disl</string>
                    <key>match</key>
                    <string>\b[0-9]+\b</string>
                </dict>
            </array>
        </dict>

        <!-- routine Foo<T>.bar(...) or routine foo<T>(...) -->
        <key>routine-decl</key>
        <dict>
            <key>match</key>
            <string>\b(routine)\s+([A-Za-z_][A-Za-z0-9_]*(?:&lt;[^&gt;(]*&gt;)?(?:\.[A-Za-z_][A-Za-z0-9_]*(?:&lt;[^&gt;(]*&gt;)?)?)</string>
            <key>captures</key>
            <dict>
                <key>1</key>
                <dict><key>name</key><string>keyword.other.declaration.disl</string></dict>
                <key>2</key>
                <dict><key>name</key><string>entity.name.function.disl</string></dict>
            </dict>
        </dict>

        <!-- block entry(): or block loop(%i: I64): -->
        <key>block-decl</key>
        <dict>
            <key>match</key>
            <string>\b(block)\s+([a-zA-Z_][a-zA-Z0-9_]*)</string>
            <key>captures</key>
            <dict>
                <key>1</key>
                <dict><key>name</key><string>keyword.other.declaration.disl</string></dict>
                <key>2</key>
                <dict><key>name</key><string>entity.name.label.disl</string></dict>
            </dict>
        </dict>

        <!-- struct Foo<T> -->
        <key>struct-decl</key>
        <dict>
            <key>match</key>
            <string>\b(struct)\s+([A-Z][A-Za-z0-9_]*(?:&lt;[^&gt;]*&gt;)?)</string>
            <key>captures</key>
            <dict>
                <key>1</key>
                <dict><key>name</key><string>keyword.other.declaration.disl</string></dict>
                <key>2</key>
                <dict><key>name</key><string>entity.name.type.disl</string></dict>
            </dict>
        </dict>

        <!-- enum Foo -->
        <key>enum-decl</key>
        <dict>
            <key>match</key>
            <string>\b(enum)\s+([A-Z][A-Za-z0-9_]*)</string>
            <key>captures</key>
            <dict>
                <key>1</key>
                <dict><key>name</key><string>keyword.other.declaration.disl</string></dict>
                <key>2</key>
                <dict><key>name</key><string>entity.name.type.disl</string></dict>
            </dict>
        </dict>

        <!-- concept Equal<T> -->
        <key>concept-decl</key>
        <dict>
            <key>match</key>
            <string>\b(concept)\s+([A-Z][A-Za-z0-9_]*)</string>
            <key>captures</key>
            <dict>
                <key>1</key>
                <dict><key>name</key><string>keyword.other.declaration.disl</string></dict>
                <key>2</key>
                <dict><key>name</key><string>entity.name.type.disl</string></dict>
            </dict>
        </dict>

        <!-- const PI: F64 = ... -->
        <key>const-decl</key>
        <dict>
            <key>match</key>
            <string>\b(const)\s+([A-Z_][A-Z0-9_]*)\b</string>
            <key>captures</key>
            <dict>
                <key>1</key>
                <dict><key>name</key><string>keyword.other.declaration.disl</string></dict>
                <key>2</key>
                <dict><key>name</key><string>variable.other.constant.disl</string></dict>
            </dict>
        </dict>

        <!-- control flow terminators -->
        <key>keywords-control</key>
        <dict>
            <key>name</key>
            <string>keyword.control.disl</string>
            <key>match</key>
            <string>\b(branch|jump|return|unreachable|select|switch)\b</string>
        </dict>

        <!-- declaration keywords (not already handled by decl patterns above) -->
        <key>keywords-declaration</key>
        <dict>
            <key>name</key>
            <string>keyword.other.declaration.disl</string>
            <key>match</key>
            <string>\b(routine|block|struct|enum|concept|const|alloca|self)\b</string>
        </dict>

        <!-- remaining keywords -->
        <key>keywords-other</key>
        <dict>
            <key>name</key>
            <string>keyword.other.disl</string>
            <key>match</key>
            <string>\b(require|typename|Self|true|false|null|conform)\b</string>
        </dict>

        <!-- built-in primitive types -->
        <key>builtin-types</key>
        <dict>
            <key>name</key>
            <string>support.type.primitive.disl</string>
            <key>match</key>
            <string>\b(I8|I16|I32|I64|F32|F64|Bool|Void|CAddr|CLong|CSize|CWChar|Ptr|Array)
            \b</string>
        </dict>

        <!-- %self / #self — the special self parameter -->
        <key>sigil-self</key>
        <dict>
            <key>name</key>
            <string>variable.language.self.disl</string>
            <key>match</key>
            <string>[%#]self\b</string>
        </dict>

        <!-- %ssa_value -->
        <key>sigil-ssa</key>
        <dict>
            <key>match</key>
            <string>(%)[a-zA-Z_][a-zA-Z0-9_]*</string>
            <key>captures</key>
            <dict>
                <key>1</key>
                <dict><key>name</key><string>punctuation.definition.variable.disl</string></dict>
                <key>0</key>
                <dict><key>name</key><string>variable.other.ssa.disl</string></dict>
            </dict>
        </dict>

        <!-- #ptr_variable -->
        <key>sigil-ptr</key>
        <dict>
            <key>match</key>
            <string>(#)[a-zA-Z_][a-zA-Z0-9_]*</string>
            <key>captures</key>
            <dict>
                <key>1</key>
                <dict><key>name</key><string>punctuation.definition.variable.disl</string></dict>
                <key>0</key>
                <dict><key>name</key><string>variable.other.pointer.disl</string></dict>
            </dict>
        </dict>

        <!-- operators -->
        <key>operators</key>
        <dict>
            <key>name</key>
            <string>keyword.operator.disl</string>
            <key>match</key>
            <string>(:=|->|==|!=|\?|~|\+|-|\*|&amp;|\||\^|!(?!=))</string>
        </dict>

    </dict>
</dict>
</plist>
