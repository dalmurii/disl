; F128 transcendentals are faithful: each result is one of the two F128 values around the
; true value (mpmath). Generated by scripts/gen_f128_math_tests.py; do not edit.

routine check(#out: Ptr<FdWriter>, %r: F128, %lo: I128, %hi: I128) -> Void
    block entry():
        %bits: I128 = %r.bits
        %ok:   Bool = %bits.eq(%lo).bitor(%bits.eq(%hi))
        branch %ok ? good() : bad(%bits)

    block good():
        write_str(#out, "ok")
        write_line(#out)
        return()

    block bad(%bits: I128):
        write_str(#out, "outside: ")
        %bits.format_hex(#out)
        write_str(#out, " not ")
        %lo.format_hex(#out)
        write_str(#out, " / ")
        %hi.format_hex(#out)
        write_line(#out)
        return()

